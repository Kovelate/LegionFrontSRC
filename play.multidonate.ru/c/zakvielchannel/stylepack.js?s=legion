    pioneer: { cloak: '#2c4a6e', lining: '#bfe3ff', line: LINE, ink: INK, w: 4, hem: 'zig', clasp: 'star' },
    capeColor: '#c0182b',   // цвет плаща, если зритель не выбрал свой
    acc: {
      cape(k, col) {   // плащ — за телом, от плеч до земли

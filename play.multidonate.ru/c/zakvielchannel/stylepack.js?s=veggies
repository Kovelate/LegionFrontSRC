        + `<path d="M${cx - 16} ${t - 13} Q${cx - 12} ${t - 38} ${cx} ${t - 40} Q${cx + 12} ${t - 38} ${cx + 16} ${t - 13} Z" fill="#f28a2e" ${S}/><path d="M${cx - 7} ${t - 30} h4 M${cx + 3} ${t - 24} h5 M${cx - 9} ${t - 19} h5" stroke="rgba(120,50,0,.5)" stroke-width="2"/>`,
      laurel: `<g stroke="#2f5a24" stroke-width="1.4">${leaves}</g>`,
      beret: `<ellipse cx="${cx - 4}" cy="${t + 2}" rx="${f1(hw + 7)}" ry="9.5" transform="rotate(-8 ${cx} ${t})" fill="${c2}" ${S}/><path d="M${cx - 2} ${t - 7} l3 -7" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>`,
      headphones: `<path d="M${f1(cx - hw - 6)} ${b.eyeY - 4} Q${f1(cx - hw - 6)} ${t - 14} ${cx} ${t - 14} Q${f1(cx + hw + 6)} ${t - 14} ${f1(cx + hw + 6)} ${b.eyeY - 4}" fill="none" stroke="#2a2440" stroke-width="5" stroke-linecap="round"/>`
        + `<rect x="${f1(cx - hw - 13)}" y="${b.eyeY - 14}" width="12" height="20" rx="5" fill="${c2}" ${S}/><rect x="${f1(cx + hw + 1)}" y="${b.eyeY - 14}" width="12" height="20" rx="5" fill="${c2}" ${S}/>`,

/* ───── стиль «veggies»: styles/veggies/characters.js ───── */
try {
/* Стиль «Овощи» — человечки Легиона в виде сердитых и смешных овощей. Форма тела = овощ:
   bean — картошка, box — кукуруза, ball — помидор, tall — морковка, ghost — луковица, cone — баклажан, egg — огурец.
   Тонкие чёрные ручки в белых мультяшных перчатках, ботиночки, глаза-«гляделки».
   Примерно каждый четвёртый овощ ИСПОРЧЕН (по нику): потемнел, в пятнах и
   плесени с мухами, с червяком из дырки или воняет (зелёные волны и мухи), под глазами мешки.
   Снаряжение — кухонное: нож, тесак, овощечистка, скалка, венчик, шампур, вилка, половник, доска, крышка, сковородка.
   Устроен как образец styles/legion/characters.js, договор — styles/README.md.
   Холст 120×170, ноги на y = 168, центр по x = 60. Каждая функция возвращает строку SVG. */
(function () {
  'use strict';
  const D = window.MDDoodle;
  if (!D) return;

  const INK = '#2b2118';
  const LEAF = '#4caf50', LEAF2 = '#3a8f3c';
  // «свой» цвет овоща: palette отдаёт этот маркер, и тело красится природным цветом овоща (b.col).
  // Если зритель купил цвет в Костюмерной, приходит другой цвет — и овощ красится им.
  const AUTO = '#c8a36b';
  const WS = `stroke="${INK}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"`;
  const RARITY = { common: null, uncommon: '#5bd36a', rare: '#5ec8ff', epic: '#c77dff', legendary: '#ffcf4a' };
  const METAL = { common: '#c3c9ce', uncommon: '#cdeec4', rare: '#bfe3ff', epic: '#e0c8ff', legendary: '#ffd76a' };
  const f1 = (v) => +v.toFixed(1);
  const pick = (r, a) => a[Math.floor(r() * a.length)];
  const FL = `fill="none" stroke="${INK}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"`;
  const colorOf = (k) => (!k.fill || k.fill === AUTO) ? (k.b.col || AUTO) : k.fill;

  /* ── тела: (r) → { L, R, top, hw, eyeY, armY, d, narrow?, veg, col, rot } ──
     veg — какой овощ, col — его природный цвет, rot — порча: 0 свежий, 1 плесень и мухи, 2 червяк, 3 воняет */
  const rotOf = (r) => { const a = r(), b = r(); return a < 0.27 ? 1 + Math.floor(b * 3) : 0; };
  const bodies = {
    bean(r) {   // картошка
      const w = 26 + Math.floor(r() * 8), L = 60 - w, R = 60 + w, top = 82;
      return { L, R, top, hw: w * 0.72, eyeY: top + 26, armY: top + 40, veg: 'potato', col: pick(r, ['#c8a06a', '#b98c58', '#d6b07a', '#a86f8a']), rot: rotOf(r),
        d: `M${L + 6} 167 C${L - 5} 158 ${L - 3} 132 ${L} 118 C${L + 2} 98 ${L + 10} ${top} 58 ${top} C${R - 4} ${top - 1} ${R + 3} 96 ${R} 116 C${R + 4} 132 ${R + 5} 156 ${R - 6} 167 Q60 171 ${L + 6} 167 Z` };
    },
    box(r) {   // кукуруза
      const w = 21 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 76 + Math.floor(r() * 10);
      return { L, R, top, hw: w * 0.8, eyeY: top + 28, armY: top + 40, veg: 'corn', col: pick(r, ['#f2c84b', '#f5d65e', '#e8b23a']), rot: rotOf(r),
        d: `M${L} 168 V${top + 16} Q${L} ${top} 60 ${top} Q${R} ${top} ${R} ${top + 16} V168 Z` };
    },
    ball(r) {   // помидор
      const w = 33 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 100;
      return { L, R, top, hw: w * 0.6, eyeY: 124, armY: 132, veg: 'tomato', col: pick(r, ['#e8402f', '#f05a3a', '#f2a23a', '#d63a5a']), rot: rotOf(r),
        d: `M60 168 C${L + 4} 168 ${L - 6} 152 ${L - 4} 134 C${L - 2} 112 ${L + 18} ${top} 60 ${top + 3} C${R - 18} ${top} ${R + 2} 112 ${R + 4} 134 C${R + 6} 152 ${R - 4} 168 60 168 Z` };
    },
    tall(r) {   // морковка
      const w = 19 + Math.floor(r() * 4), L = 60 - w, R = 60 + w, top = 62;
      return { L, R, top, hw: w * 0.8, eyeY: top + 22, armY: top + 36, narrow: true, veg: 'carrot', col: pick(r, ['#f28a2e', '#f59a3a', '#e8742a']), rot: rotOf(r),
        d: `M${L} ${top + 14} Q${L} ${top} 60 ${top} Q${R} ${top} ${R} ${top + 14} C${R} 110 ${R - 6} 150 ${R - 9} 167 Q60 171 ${L + 9} 167 C${L + 6} 150 ${L} 110 ${L} ${top + 14} Z` };
    },
    ghost(r) {   // луковица (снизу корешки)
      const w = 27 + Math.floor(r() * 5), L = 60 - w, R = 60 + w, top = 84;
      return { L, R, top, hw: w * 0.62, eyeY: 108, armY: 120, veg: 'onion', col: pick(r, ['#c45a8a', '#d9a85a', '#ece4cc', '#b8487a']), rot: rotOf(r),
        d: `M60 ${top - 12} C66 ${top + 4} ${R + 4} ${top + 16} ${R + 2} 130 C${R} 150 ${R - 10} 160 70 162 L50 162 C${L + 10} 160 ${L} 150 ${L - 2} 130 C${L - 4} ${top + 16} 54 ${top + 4} 60 ${top - 12} Z` };
    },
    cone(r) {   // баклажан
      const w = 28 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 76;
      return { L, R, top, hw: 14, eyeY: 106, armY: 122, narrow: true, veg: 'eggplant', col: pick(r, ['#6a3a8a', '#7a3f9a', '#5a3070']), rot: rotOf(r),
        d: `M60 ${top} C74 ${top} ${R - 6} 110 ${R} 140 C${R + 3} 160 ${R - 8} 168 60 168 C${L + 8} 168 ${L - 3} 160 ${L} 140 C${L + 6} 110 46 ${top} 60 ${top} Z` };
    },
    egg(r) {   // огурец
      const w = 22 + Math.floor(r() * 5), L = 60 - w, R = 60 + w, top = 66;
      return { L, R, top, hw: w * 0.75, eyeY: top + 26, armY: top + 42, narrow: w < 24, veg: 'cucumber', col: pick(r, ['#5fa84a', '#4f9a3e', '#6fb85a']), rot: rotOf(r),
        d: `M60 ${top} C${R} ${top} ${R + 2} 120 ${R} 150 Q${R - 2} 168 60 168 Q${L + 2} 168 ${L} 150 C${L - 2} 120 ${L} ${top} 60 ${top} Z` };
    },
  };

  const starPts = (x, y, ro, ri, n, ys = 1, rot = -90) => { let d = ''; for (let i = 0; i < n * 2; i++) { const a = (i * 180 / n + rot) * Math.PI / 180, q = i % 2 ? ri : ro; d += `${i ? 'L' : 'M'}${f1(x + Math.cos(a) * q)} ${f1(y + Math.sin(a) * q * ys)}`; } return d + 'Z'; };
  const outlined = (d, col, w = 4.5) => `<path d="${d}" fill="none" stroke="${INK}" stroke-width="${w + 3}" stroke-linecap="round"/><path d="${d}" fill="none" stroke="${col}" stroke-width="${w}" stroke-linecap="round"/>`;
  // муха кружит вокруг точки
  const fly = (cx, cy, rad, dur, dir, beg) => `<g><animateTransform attributeName="transform" type="rotate" values="0 ${cx} ${cy};${dir * 360} ${cx} ${cy}" dur="${dur}s" begin="-${beg}s" repeatCount="indefinite"/><g transform="translate(${cx + rad} ${cy})"><ellipse cx="-1.6" cy="-2.6" rx="2.3" ry="1.4" fill="rgba(235,245,255,.85)"/><ellipse cx="1.6" cy="-2.6" rx="2.3" ry="1.4" fill="rgba(235,245,255,.85)"/><circle r="2.1" fill="#161616"/></g></g>`;

  // тело: листья/ботва сзади → овощ → прожилки и узоры → чашелистик спереди → порча → ботиночки
  function body(k) {
    const b = k.b, col = colorOf(k), v = b.veg, t = b.top, L = b.L, R = b.R, seed = k.seed >>> 0, d0 = ((seed % 997) / 997 * 2).toFixed(2);
    let back = '', deco = '', front = '';
    if (v === 'carrot') {
      back = outlined(`M60 ${t + 4} q-14 -10 -16 -26 M60 ${t + 2} q0 -14 2 -30 M60 ${t + 4} q12 -8 16 -24`, LEAF, 4.5);
      for (let y = t + 30, i = 0; y < 160; y += 17, i++) deco += i % 2 ? `M${R - 2} ${y} h-7 ` : `M${L + 2} ${y} h7 `;
      deco = `<path d="${deco}" stroke="rgba(120,50,0,.45)" stroke-width="2" stroke-linecap="round"/>`;
    } else if (v === 'tomato') {
      front = `<path d="${starPts(60, t + 4, 15, 4, 5, 0.55)}" fill="${LEAF2}" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/><path d="M60 ${t + 3} q1 -7 4 -9" fill="none" stroke="${INK}" stroke-width="5" stroke-linecap="round"/><path d="M60 ${t + 3} q1 -7 4 -9" fill="none" stroke="${LEAF2}" stroke-width="2.6" stroke-linecap="round"/>`;
      deco = `<path d="M${L + 8} 140 q4 -18 18 -26 M${R - 8} 140 q-4 -18 -18 -26" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="2.5" stroke-linecap="round"/><ellipse cx="${L + 14}" cy="${t + 18}" rx="5" ry="3" transform="rotate(-30 ${L + 14} ${t + 18})" fill="rgba(255,255,255,.4)"/>`;
    } else if (v === 'eggplant') {
      front = `<path d="${starPts(60, t + 5, 16, 5, 5, 0.6, 90)}" fill="${LEAF2}" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>` + outlined(`M60 ${t + 2} q1 -8 6 -11`, LEAF2, 3.4);
      deco = `<path d="M${R - 10} 128 q4 14 -2 28" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="3" stroke-linecap="round"/>`;
    } else if (v === 'corn') {
      back = `<path d="M${L + 8} 168 C${L - 14} 140 ${L - 12} 108 ${L + 2} ${t + 26} C${L + 6} 128 ${L + 10} 150 ${L + 20} 168 Z M${R - 8} 168 C${R + 14} 140 ${R + 12} 108 ${R - 2} ${t + 26} C${R - 6} 128 ${R - 10} 150 ${R - 20} 168 Z" fill="${LEAF}" stroke="${INK}" stroke-width="2.4" stroke-linejoin="round"/>`;
      const p = k.uid('jlK');
      deco = `<defs><pattern id="${p}" patternUnits="userSpaceOnUse" width="7" height="6.5"><rect x=".8" y=".6" width="5.4" height="5.2" rx="2.2" fill="rgba(255,255,255,.3)" stroke="rgba(120,70,0,.35)" stroke-width=".8"/></pattern></defs><path d="${b.d}" fill="url(#${p})"/>`;
      front = `<path d="M${L + 2} 168 C${L + 4} 150 ${L + 2} 140 ${L - 2} 128 C${L + 10} 136 ${L + 14} 152 ${L + 14} 168 Z M${R - 2} 168 C${R - 4} 150 ${R - 2} 140 ${R + 2} 128 C${R - 10} 136 ${R - 14} 152 ${R - 14} 168 Z" fill="${LEAF2}" stroke="${INK}" stroke-width="2.2" stroke-linejoin="round"/>`;
    } else if (v === 'onion') {
      back = outlined(`M60 ${t - 10} q-7 -14 -3 -28 M60 ${t - 10} q6 -12 5 -24`, LEAF, 3.6);
      deco = `<path d="M60 ${t - 8} Q${L + 6} 122 52 161 M60 ${t - 8} Q${R - 6} 122 68 161 M60 ${t - 8} V161" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="2"/>`;
      front = `<path d="M52 161 q-2 4 -6 7 M56 162 q0 3 -2 6 M60 162 v6 M64 162 q0 3 2 6 M68 161 q2 4 6 7" fill="none" stroke="${INK}" stroke-width="1.8" stroke-linecap="round"/>`;
    } else if (v === 'cucumber') {
      deco = `<path d="M${f1(60 - b.hw * 0.5)} ${t + 10} Q${f1(60 - b.hw * 0.7)} 118 ${f1(60 - b.hw * 0.5)} 162 M${f1(60 + b.hw * 0.5)} ${t + 10} Q${f1(60 + b.hw * 0.7)} 118 ${f1(60 + b.hw * 0.5)} 162" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="5"/>`
        + `<g fill="rgba(20,60,10,.45)"><circle cx="${L + 6}" cy="${t + 40}" r="1.6"/><circle cx="${R - 5}" cy="${t + 52}" r="1.6"/><circle cx="${L + 5}" cy="140" r="1.6"/><circle cx="${R - 6}" cy="150" r="1.6"/><circle cx="${L + 9}" cy="${t + 64}" r="1.4"/><circle cx="${R - 9}" cy="${t + 28}" r="1.4"/></g>`;
      front = `<path d="M60 ${t + 1} q-1 -5 2 -8" fill="none" stroke="#6b4a2a" stroke-width="4" stroke-linecap="round"/>`;
    } else {   // картошка: глазки
      deco = `<path d="M${L + 9} 132 q2 2 4 0 M${R - 12} ${t + 18} q2 2 4 0 M${R - 9} 150 q2 2 4 0 M${L + 14} ${t + 12} q2 2 4 0" fill="none" stroke="rgba(80,50,20,.6)" stroke-width="1.6" stroke-linecap="round"/><g fill="rgba(80,50,20,.35)"><circle cx="${L + 18}" cy="152" r="1.5"/><circle cx="${R - 16}" cy="128" r="1.5"/></g>`;
    }
    let s = back + `<path d="${b.d}" fill="${col}" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>` + deco + front;
    // ── порча ──
    if (b.rot) {
      const c = k.uid('jlP');
      s += `<path d="${b.d}" fill="rgba(70,60,10,.32)"/><defs><clipPath id="${c}"><path d="${b.d}"/></clipPath></defs><g clip-path="url(#${c})" fill="#5a3d1e" opacity=".5"><ellipse cx="${L + 10}" cy="${b.armY + 22}" rx="7" ry="5.5"/><ellipse cx="${R - 12}" cy="156" rx="6" ry="4.5"/><ellipse cx="${60 + 8}" cy="${t + 12}" rx="4" ry="3"/></g>`;
      if (b.rot === 1) {   // плесень пушистыми пятнами + мухи
        s += `<g clip-path="url(#${c})"><path d="M${R - 14} ${t + 26} a5 5 0 1 1 6 4 a4 4 0 1 1 -2 7 a4 4 0 1 1 -6 -3 a4 4 0 1 1 2 -8 z M${L + 4} 150 a5 5 0 1 1 7 3 a4 4 0 1 1 -3 7 a4 4 0 1 1 -5 -6 z" fill="#a9c48f" stroke="#6f8f5a" stroke-width="1.2"/><g fill="#eef7e4"><circle cx="${R - 11}" cy="${t + 29}" r="1.1"/><circle cx="${R - 15}" cy="${t + 34}" r="1"/><circle cx="${L + 8}" cy="153" r="1.1"/></g></g>`
          + fly(60, t - 8, 20, 1.7, 1, d0) + fly(60, t + 4, 26, 2.3, -1, d0);
      } else if (b.rot === 2) {   // червяк высунулся из дырки и качается
        const hx = f1(60 + (R - L) * 0.28), hy = b.armY + 16;
        s += `<ellipse cx="${hx}" cy="${hy}" rx="4.4" ry="3.8" fill="#3a2414" stroke="${INK}" stroke-width="1.4"/>`
          + `<g><animateTransform attributeName="transform" type="rotate" values="-18 ${hx} ${hy};16 ${hx} ${hy};-18 ${hx} ${hy}" dur="1.4s" begin="-${d0}s" repeatCount="indefinite"/>`
          + outlined(`M${hx} ${hy} q9 -2 11 -10 q2 -6 -2 -9`, '#f39ab0', 4.2)
          + `<circle cx="${f1(hx + 8.6)}" cy="${hy - 20}" r="1.1" fill="${INK}"/><circle cx="${f1(hx + 11.2)}" cy="${hy - 19}" r="1.1" fill="${INK}"/><path d="M${f1(hx + 7.8)} ${hy - 16.4} q2 1.5 4 0" fill="none" stroke="${INK}" stroke-width="1"/></g>`;
      } else {   // воняет: зелёные волны поднимаются, мухи
        const w = (x, dl) => `<path d="M${x} ${t - 2} q-4 -5 0 -10 q4 -5 0 -10" fill="none" stroke="#9acd32" stroke-width="2.4" stroke-linecap="round" opacity="0"><animate attributeName="opacity" values="0;.9;0" dur="2s" begin="-${dl}s" repeatCount="indefinite"/><animateTransform attributeName="transform" type="translate" values="0 6;0 -10" dur="2s" begin="-${dl}s" repeatCount="indefinite"/></path>`;
        s += w(48, 0) + w(60, 0.7) + w(72, 1.3) + fly(60, t - 6, 22, 1.9, -1, d0);
      }
    }
    if (v !== 'onion') s += `<g fill="#6b4a32" stroke="${INK}" stroke-width="1.8"><ellipse cx="51" cy="167" rx="7.5" ry="3.8"/><ellipse cx="69" cy="167" rx="7.5" ry="3.8"/></g>`;   // ботиночки
    return s;
  }

  /* ── лицо: глаза-гляделки, зубастые рты; у испорченных — мешки под глазами ── */
  const pupilOff = (k) => { const a = ((k.seed >>> 0) % 8) * 45 * Math.PI / 180; return [f1(Math.cos(a) * 2), f1(Math.sin(a) * 2)]; };
  const goggle = (x, y, rr, px, py, pr = 2.6) => `<circle cx="${x}" cy="${y}" r="${rr}" fill="#fff" stroke="${INK}" stroke-width="1.8"/><circle cx="${f1(x + px)}" cy="${f1(y + py)}" r="${pr}" fill="${INK}"/>`;
  const bags = (k) => k.b && k.b.rot ? `<path d="M${60 - k.ex - 5} ${k.ey + 7} q5 3 10 0 M${60 + k.ex - 5} ${k.ey + 7} q5 3 10 0" fill="none" stroke="#7a4a8a" stroke-width="1.8" stroke-linecap="round" opacity=".8"/>` : '';
  const BW = `fill="none" stroke="${INK}" stroke-width="3" stroke-linecap="round"`;
  function eyes(kind, k) {
    const { ex, ey } = k, xs = [60 - ex, 60 + ex], [px, py] = pupilOff(k);
    let e;
    if (kind === 'dots') e = xs.map((x) => `<ellipse cx="${x}" cy="${ey}" rx="3.2" ry="4.2" fill="${INK}"/><circle cx="${x - 1}" cy="${ey - 1.6}" r="1.2" fill="#fff"/>`).join('');
    else if (kind === 'big') e = goggle(xs[0], ey, 6.4, px, py) + goggle(xs[1], ey, 6.4, px, py);
    else if (kind === 'derp') e = goggle(xs[0], ey + 1, 5, 2.2, 0.5, 2.3) + goggle(xs[1], ey - 1, 7, -3, 1, 2.8);   // косые, разного размера
    else if (kind === 'cyclops') e = goggle(60, ey - 1, 9.5, px * 1.5, py * 1.5, 3.6);
    else if (kind === 'stars') e = `<path d="${starPts(xs[0], ey, 5.8, 2.6, 5)}${starPts(xs[1], ey, 5.8, 2.6, 5)}" fill="#ffd23f" stroke="${INK}" stroke-width="1.5" stroke-linejoin="round"/>`;
    else if (kind === 'sleepy') e = xs.map((x) => `<path d="M${x - 6} ${ey} a6 5.5 0 0 0 12 0 z" fill="#fff" stroke="${INK}" stroke-width="1.6"/><circle cx="${x}" cy="${ey + 2}" r="2.2" fill="${INK}"/><path d="M${x - 7} ${ey} h14" ${BW}/>`).join('');
    else e = `<path d="M${60 - ex - 5} ${ey + 1} q5 -6 10 0 M${60 + ex - 5} ${ey + 1} q5 -6 10 0" ${FL}/>`;   // happy
    return e + bags(k);
  }
  function mouth(kind, k) {
    const my = k.my;
    if (kind === 'open') return `<path d="M50 ${my - 3} Q60 ${my + 17} 70 ${my - 3} Z" fill="#6a1f2c" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/><ellipse cx="60" cy="${my + 6}" rx="4.4" ry="2.4" fill="#ff8fa3"/>`;   // орёт
    if (kind === 'grin') return `<path d="M49 ${my - 3} Q60 ${my + 9} 71 ${my - 3}" ${FL}/><path d="M56.6 ${my + 0.4} h6.8 v6 h-6.8 z M60 ${my + 0.4} v6" fill="#fff" stroke="${INK}" stroke-width="1.5" stroke-linejoin="round"/>`;   // два заячьих зуба
    return `<path d="M51 ${my - 2} q9 7 18 0" ${FL}/><path d="M57 ${my + 1} q3 9 6 0 z" fill="#ff7f9a" stroke="${INK}" stroke-width="1.4" stroke-linejoin="round"/>`;
  }
  const faces = {
    sad(k) {   // гляделки с опущенными веками, губа дрожит, слеза
      const { ex, ey, my } = k;
      const lidded = (x, rr) => `<circle cx="${x}" cy="${ey}" r="${rr}" fill="#fff" stroke="${INK}" stroke-width="1.8"/><circle cx="${x}" cy="${ey + 2}" r="2.6" fill="${INK}"/><path d="M${x - rr} ${ey - 1} Q${x} ${ey - rr - 1} ${x + rr} ${ey - 1} Z" fill="${INK}" opacity=".85"/>`;
      const e = (k.cyc ? lidded(60, 9) : lidded(60 - ex, 6) + lidded(60 + ex, 6) + `<path d="M${60 - ex - 7} ${ey - 8} l9 -3 M${60 + ex + 7} ${ey - 8} l-9 -3" ${BW}/>`)
        + `<path class="tear" d="M${60 + ex + 4} ${ey + 6} q-3 6 0 8 q3 -2 0 -8 z" fill="#8fd3ff" stroke="${INK}" stroke-width="1.2"/>` + bags(k);
      return { eyes: e, mouth: `<path d="M51 ${my + 4} q3 -4 6 -2 q3 -3 6 0 q3 -2 6 2" ${FL}/>` };
    },
    chill(k) {   // разомлел: глаза дугами вниз, довольная ухмылка
      const { ex, ey, my } = k;
      return { eyes: (k.cyc ? `<path d="M51 ${ey - 1} q9 6 18 0" ${FL}/>` : `<path d="M${60 - ex - 5} ${ey} q5 4 10 0 M${60 + ex - 5} ${ey} q5 4 10 0" ${FL}/>`) + bags(k), mouth: `<path d="M50 ${my - 2} q10 8 20 -1" ${FL}/>` };
    },
    stern(k) {   // злой овощ: брови домиком вниз, зубы стиснуты
      const { ex, ey, my } = k;
      return { eyes: (k.cyc ? goggle(60, ey, 8.5, 0, 1, 2.6) + `<path d="M47 ${ey - 13} l13 6 l13 -6" ${BW}/>` : goggle(60 - ex, ey + 1, 5.6, 1, 1, 2.2) + goggle(60 + ex, ey + 1, 5.6, -1, 1, 2.2) + `<path d="M${60 - ex - 8} ${ey - 11} l12 6 M${60 + ex + 8} ${ey - 11} l-12 6" ${BW}/>`) + bags(k),
        mouth: `<rect x="51" y="${my - 3}" width="18" height="7" rx="2.5" fill="#fff" stroke="${INK}" stroke-width="1.8"/><path d="M51 ${my + 0.5} h18 M55.5 ${my - 3} v7 M60 ${my - 3} v7 M64.5 ${my - 3} v7" stroke="${INK}" stroke-width="1"/>` };
    },
    hurt(k) {   // глаз-спираль, второй крестиком, рот волной
      const { ex, ey, my } = k;
      const sp = (x, y) => `<path d="M${x} ${y} m-1 0 a1 1 0 1 1 2 0 a2.5 2.5 0 1 1 -4.5 0 a4 4 0 1 1 8 0" fill="none" stroke="${INK}" stroke-width="1.6" stroke-linecap="round"/>`;
      return { eyes: (k.cyc ? sp(60, ey) + `<circle cx="60" cy="${ey}" r="8" fill="none" stroke="${INK}" stroke-width="1.8"/>` : `<path d="M${60 - ex - 4} ${ey - 4} l8 8 M${60 - ex + 4} ${ey - 4} l-8 8" ${FL}/>${sp(60 + ex, ey)}`) + bags(k),
        mouth: `<path d="M51 ${my + 2} q3 -4 6 0 q3 4 6 0 q3 -4 6 0" ${FL}/>` };

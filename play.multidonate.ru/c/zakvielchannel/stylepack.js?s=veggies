      party: `<path d="M${cx - 12} ${t + 6} L${cx} ${t - 30} L${cx + 12} ${t + 6} z" fill="${c2}" ${S}/><circle cx="${cx}" cy="${t - 32}" r="4.5" fill="#fff" ${S}/><circle cx="${cx - 3}" cy="${t - 4}" r="2" fill="#fff"/><circle cx="${cx + 4}" cy="${t - 14}" r="2" fill="#fff"/>`,
      wizard: `<path d="M${f1(cx - hw - 6)} ${t + 10} L${cx + 4} ${t - 38} Q${cx + 12} ${t - 34} ${cx + 20} ${t - 28} L${f1(cx + hw + 6)} ${t + 10} z" fill="#4b3bb8" ${S}/><path d="${starPts(cx + 1, t - 10, 5, 2.2, 5)}" fill="#ffc94d"/>`,
      antenna: `<path d="M${cx} ${t} q-6 -14 4 -24" ${FL}/><circle cx="${cx + 4}" cy="${t - 27}" r="5.5" fill="${c2}" ${S}/>`,
      antenna2: `<path d="M${cx - 6} ${t + 2} l-8 -20 M${cx + 6} ${t + 2} l8 -20" ${FL}/><circle cx="${cx - 14}" cy="${t - 20}" r="5" fill="${c2}" ${S}/><circle cx="${cx + 14}" cy="${t - 20}" r="5" fill="${c2}" ${S}/>`,

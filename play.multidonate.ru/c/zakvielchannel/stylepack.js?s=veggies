      bunny: `<ellipse cx="${cx - 9}" cy="${t - 16}" rx="6" ry="18" fill="#f7f2ee" ${S}/><ellipse cx="${cx + 9}" cy="${t - 16}" rx="6" ry="18" fill="#f7f2ee" ${S}/><ellipse cx="${cx - 9}" cy="${t - 15}" rx="2.6" ry="12" fill="#ff9fb4"/><ellipse cx="${cx + 9}" cy="${t - 15}" rx="2.6" ry="12" fill="#ff9fb4"/>`,
      halo: `<ellipse cx="${cx}" cy="${t - 16}" rx="17" ry="5" fill="none" stroke="#ffe27a" stroke-width="3.8"/>`,
      sprout: `<path d="M${cx} ${t + 1} v-14" stroke="${LEAF2}" stroke-width="2.6" stroke-linecap="round"/><path d="M${cx} ${t - 9} q-13 -1 -13 -11 q11 0 13 11 z M${cx} ${t - 12} q11 -3 13 -13 q-11 0 -13 13 z" fill="#6fdc6f" ${S}/>`,
      bandana: `<path d="M${f1(cx - hw - 2)} ${t + 16} Q${cx} ${t - 6} ${f1(cx + hw + 2)} ${t + 16} Z" fill="#e8455c" ${S}/><path d="M${f1(cx + hw)} ${t + 14} l12 -2 l-4 10 z" fill="#e8455c" ${S}/><circle cx="${cx - 6}" cy="${t + 7}" r="1.5" fill="#fff"/><circle cx="${cx + 6}" cy="${t + 5}" r="1.5" fill="#fff"/><circle cx="${cx}" cy="${t + 10}" r="1.5" fill="#fff"/>`,

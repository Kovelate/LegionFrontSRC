  /* ── снаряжение: кухонное ── */
  function weapon(kind, rar) {
    const m = METAL[rar] || METAL.common, hi = rar && rar !== 'common', wood = '#b88a52', dw = '#3a2a24';
    const grip = (y0, y1, w = 5, c = wood) => `<rect x="${-w / 2}" y="${y1}" width="${w}" height="${y0 - y1}" rx="2" fill="${c}" ${WS}/>`;
    switch (kind) {
      case 'sword': return `${grip(16, -2, 6, dw)}<circle cy="3" r="1" fill="#ddd"/><circle cy="10" r="1" fill="#ddd"/><path d="M-3 -2 V-56 Q9 -40 7 -2 Z" fill="${m}" ${WS}/><path d="M-1 -8 V-48" stroke="rgba(255,255,255,.7)" stroke-width="1.4"/>`;   // поварской нож
      case 'gladius': return `${grip(16, -2, 6)}<path d="M-4 -2 H14 V-40 H-4 Z" fill="${m}" ${WS}/><circle cx="9" cy="-34" r="2.4" fill="none" stroke="${INK}" stroke-width="1.6"/>`;   // тесак
      case 'dagger': return `${grip(14, -6, 7, '#5fbf6a')}<path d="M-4 -6 V-24 Q0 -30 4 -24 V-6" fill="none" stroke="${INK}" stroke-width="5" stroke-linecap="round"/><path d="M-4 -6 V-24 Q0 -30 4 -24 V-6" fill="none" stroke="${m}" stroke-width="2.6" stroke-linecap="round"/><path d="M0 -10 V-22" stroke="${INK}" stroke-width="1.2"/>`;   // овощечистка
      case 'axe': return `${grip(14, -30)}<path d="M0 -30 L0 -38" stroke="${INK}" stroke-width="3"/><circle cy="-44" r="12" fill="${m}" ${WS}/><circle cy="-44" r="2.6" fill="${INK}"/><path d="M-8 -44 h16 M0 -52 v16" stroke="rgba(0,0,0,.15)" stroke-width="1.2"/>`;   // нож для пиццы
      case 'club': return `<rect x="-2.5" y="-4" width="5" height="16" rx="2" fill="${wood}" ${WS}/><rect x="-7" y="-52" width="14" height="48" rx="6" fill="${hi ? m : '#e2bf86'}" ${WS}/><rect x="-2.5" y="-64" width="5" height="12" rx="2" fill="${wood}" ${WS}/>`;   // скалка
      case 'mace': { const wires = 'M0 -8 C-13 -20 -11 -50 0 -54 C11 -50 13 -20 0 -8 M0 -8 C-6 -20 -6 -50 0 -54 C6 -50 6 -20 0 -8'; return `${grip(14, -8, 6, '#e8455c')}<path d="${wires}" fill="none" stroke="${INK}" stroke-width="4"/><path d="${wires}" fill="none" stroke="${m}" stroke-width="2"/>`; }   // венчик
      case 'hammer': return `${grip(14, -40)}<rect x="-13" y="-54" width="26" height="15" rx="2" fill="${m}" ${WS}/><path d="M-13 -54 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4" fill="${m}" ${WS}/>`;   // молоток для отбивных
      case 'spear': return `<rect x="-1.6" y="-80" width="3.2" height="108" rx="1.5" fill="${m}" ${WS}/><path d="M-1.6 -80 L0 -88 L1.6 -80 Z" fill="${m}" ${WS}/><circle cy="-28" r="6" fill="#e8402f" ${WS}/><rect x="-6" y="-46" width="12" height="9" rx="2" fill="#ece4cc" ${WS}/><rect x="-6" y="-62" width="12" height="9" rx="2" fill="#5fa84a" ${WS}/><circle cy="-72" r="5" fill="#e8402f" ${WS}/>`;   // шампур с овощами
      case 'pitchfork': { const t = 'M-9 -56 q9 8 18 0 M-9 -56 V-76 M-3 -58 V-78 M3 -58 V-78 M9 -56 V-76'; return `<rect x="-3" y="-50" width="6" height="82" rx="3" fill="${m}" ${WS}/><path d="${t}" fill="none" stroke="${INK}" stroke-width="5.6" stroke-linecap="round"/><path d="${t}" fill="none" stroke="${m}" stroke-width="2.8" stroke-linecap="round"/>`; }   // вилка
      case 'bow': return `<path d="M-2 -44 C16 -30 16 30 -2 44" fill="none" stroke="${INK}" stroke-width="7.5" stroke-linecap="round"/><path d="M-2 -44 C16 -30 16 30 -2 44" fill="none" stroke="${hi ? m : LEAF}" stroke-width="4" stroke-linecap="round"/><path d="M-2 -44 L-6 0 L-2 44" fill="none" stroke="${INK}" stroke-width="1.4"/><ellipse cx="-2" cy="-44" rx="3" ry="4" fill="#f3efe0" ${WS}/>`;   // лук из зелёного лука
      case 'staff': return `<rect x="-2.5" y="-62" width="5" height="96" rx="2" fill="${m}" ${WS}/><path d="M-11 -70 A11 11 0 0 0 11 -70 Z" fill="${m}" ${WS}/><path d="M-8 -70 A8 7 0 0 0 8 -70 Z" fill="${hi ? RARITY[rar] : '#f28a2e'}" opacity=".85"/>`;   // половник с супом
      case 'crook': return outlined('M0 32 V-48 C-3 -62 10 -68 13 -58 C15 -50 5 -47 5 -54', hi ? m : '#7cbf4a', 4.4) + `<path d="M0 -10 l-4 -3 M0 -26 l4 -3 M0 6 l4 -3" stroke="${INK}" stroke-width="1.4"/>`;   // спаржа-посох
      case 'censer': return `<path d="M0 0 V20" stroke="${INK}" stroke-width="2" stroke-dasharray="3 2"/><path d="M-10 22 h20 l-2 14 q-8 4 -16 0 Z" fill="${hi ? m : '#5a5a66'}" ${WS}/><path d="M-12 22 h24" stroke="${INK}" stroke-width="3" stroke-linecap="round"/><circle cx="-4" cy="14" r="3" fill="rgba(235,235,245,.55)"/><circle cx="2" cy="8" r="4" fill="rgba(235,235,245,.45)"/><circle cx="-1" cy="0" r="3.4" fill="rgba(235,235,245,.35)"/>`;   // котелок с паром
      default: return '';
    }
  }
  function shield(kind, rar) {
    const m = METAL[rar] || METAL.common;
    switch (kind) {
      case 'scutum': return `<rect x="-13" y="-21" width="26" height="42" rx="6" fill="#d6a868" ${WS}/><circle cy="-14" r="3" fill="#2b2118"/><path d="M-6 0 l8 -6 M-4 8 l10 -4 M-7 14 l6 -2" stroke="rgba(90,50,10,.45)" stroke-width="1.4"/><rect x="-13" y="-21" width="26" height="42" rx="6" fill="none" stroke="${m}" stroke-width="1.5" opacity="${rar && rar !== 'common' ? 1 : 0}"/>`;   // разделочная доска
      case 'round': return `<circle r="15" fill="${m}" ${WS}/><circle r="11.5" fill="none" stroke="rgba(0,0,0,.18)" stroke-width="2"/><rect x="-5" y="-3" width="10" height="5" rx="2.5" fill="#2b2118"/>`;   // крышка от кастрюли
      case 'buckler': return `<rect x="9" y="-2.5" width="12" height="5" rx="2" fill="#2b2118"/><circle r="11" fill="#3a3a44" ${WS}/><circle r="9" fill="none" stroke="${m}" stroke-width="1.6"/><path d="M-6 -2 q-1 -6 5 -6 q6 -2 7 3 q3 5 -2 8 q-5 3 -8 0 q-4 -1 -2 -5 z" fill="#fff"/><circle cx="0" cy="-1" r="3" fill="#ffc22e"/>`;   // сковородка с яичницей
      case 'barrel': return `<circle r="14" fill="#a0703a" ${WS}/><path d="M-13 -5 H13 M-13 4 H13" stroke="#6b4423" stroke-width="2"/><circle r="11.5" fill="none" stroke="${rar && rar !== 'common' ? m : '#4a4a4f'}" stroke-width="2.5"/><ellipse rx="7" ry="3.6" fill="#5fa84a" stroke="${INK}" stroke-width="1.2"/>`;   // бочка с огурцами
      default: return '';
    }
  }
  // доспехи овощей: сама вещь без стойки, низ на y = 0. Лорика — фартук повара, мантия — скатерть в клетку
  const ARMOR_RAR = { uncommon: '#4cc95a', rare: '#4aa3ff', epic: '#b06bff', legendary: '#ffb83d' };
  function armor(kind, rar) {
    const tr = rar === 'common' || !ARMOR_RAR[rar] ? null : ARMOR_RAR[rar];
    if (kind === 'robe') {
      const base = '#f4f1ea', check = tr || '#e8402f';
      let cells = '';
      for (let y = -100; y < 0; y += 10) for (let x = -44; x < 44; x += 10) if (((x + 44) / 10 + (y + 100) / 10) % 2 === 0) cells += `<rect x="${x}" y="${y}" width="10" height="10" fill="${check}" opacity=".85"/>`;
      return `<defs><clipPath id="vegRobeClip"><path d="M-22 -102 C-30 -70 -38 -30 -42 0 H42 C38 -30 30 -70 22 -102 Q0 -92 -22 -102 Z"/></clipPath></defs>`
        + `<path d="M-22 -102 C-30 -70 -38 -30 -42 0 H42 C38 -30 30 -70 22 -102 Q0 -92 -22 -102 Z" fill="${base}"/><g clip-path="url(#vegRobeClip)">${cells}</g>`
        + `<path d="M-22 -102 C-30 -70 -38 -30 -42 0 H42 C38 -30 30 -70 22 -102 Q0 -92 -22 -102 Z" fill="none" ${WS}/>`
        + `<path d="M-40 0 l2 6 M-30 0 l1 6 M-20 0 v6 M-10 0 v6 M0 0 v6 M10 0 v6 M20 0 v6 M30 0 l-1 6 M40 0 l-2 6" stroke="${INK}" stroke-width="1.6" stroke-linecap="round"/>`
        + `<circle cx="-6" cy="-60" r="5" fill="#ffd23f" ${WS}/><circle cx="6" cy="-46" r="4" fill="#ffd23f" ${WS}/>`;
    }
    const cloth = '#fbfaf6', trim = tr || '#e8402f';
    return `<path d="M-12 -104 Q0 -112 12 -104" fill="none" stroke="${trim}" stroke-width="3"/>`
      + `<path d="M-16 -100 H16 V-70 L30 -60 V0 H-30 V-60 L-16 -70 Z" fill="${cloth}" ${WS}/>`
      + `<path d="M-30 -60 H30" stroke="${trim}" stroke-width="3"/><path d="M-30 -4 H30" stroke="${trim}" stroke-width="5"/>`
      + `<path d="M-30 -60 q-10 4 -14 12 M30 -60 q10 4 14 12" fill="none" stroke="${trim}" stroke-width="3" stroke-linecap="round"/>`
      + `<rect x="-12" y="-44" width="24" height="16" rx="3" fill="none" stroke="${INK}" stroke-width="1.8"/>`
      + `<path d="M0 -92 L-5 -76 L5 -76 Z" fill="#ff8a3d" ${WS}/><path d="M0 -92 l-3 -6 M0 -92 l3 -6 M0 -92 v-7" stroke="#4caf50" stroke-width="2.2" stroke-linecap="round"/>`
      + `<path d="M-18 -20 q4 -4 8 0 M6 -14 q4 -4 8 0" fill="none" stroke="rgba(160,90,40,.45)" stroke-width="2"/>`;
  }

  /* ── ауры: свечение за овощем, поднимаются семечки, звёзды, огоньки, снежинки ── */
  const AURA = { gold: ['#ffd76a', '#ffb83d'], sparks: ['#fff6c8', '#ffd76a'], halo: ['#ffe27a', '#ffe27a'], shadow: ['#a24bff', '#3a0f66'], frost: ['#bfe8ff', '#6fb8ff'] };
  function aura(kind, k) {
    const b = k.b, seed = k.seed >>> 0;
    const c = AURA[kind]; if (!c) return { back: '', front: '' };
    const id = k.uid('jlA'), d0 = (seed % 997) / 997 * 2;
    const cx = 60, cy = (b.top + 170) / 2 + 2, rx = (b.R - b.L) / 2 + 46, ry = (170 - b.top) / 2 + 42;
    let back = '', front = '';
    const glow = (op1, op2, dur) => `<defs><radialGradient id="${id}"><stop offset=".3" stop-color="${c[0]}"/><stop offset=".62" stop-color="${c[1]}" stop-opacity=".7"/><stop offset="1" stop-color="${c[1]}" stop-opacity="0"/></radialGradient></defs>`
      + `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="url(#${id})"><animate attributeName="opacity" values="${op1};${op2};${op1}" dur="${dur}s" begin="-${d0.toFixed(2)}s" repeatCount="indefinite"/></ellipse>`;
    const motes = (n, col, shape, size) => Array.from({ length: n }, (_, i) => {
      const x = b.L - 8 + ((i * 37 + (seed >>> (i % 8))) % (b.R - b.L + 16)), y0 = 168 - (i * 23) % 40, dur = 1.8 + (i % 4) * 0.45, beg = ((i * 0.53 + d0) % dur).toFixed(2);

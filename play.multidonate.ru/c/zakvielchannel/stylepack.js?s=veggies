  };
  const blush = (k) => `<ellipse cx="${60 - k.ex - 8}" cy="${k.ey + 9}" rx="4.4" ry="2.6" fill="#ff6f8f" opacity=".5"/><ellipse cx="${60 + k.ex + 8}" cy="${k.ey + 9}" rx="4.4" ry="2.6" fill="#ff6f8f" opacity=".5"/>`;
  // ранен: от овоща откусили кусок (видна мякоть) + пластырь
  function hurt(k) {
    const b = k.b, bx = f1(60 + (b.R - b.L) * 0.32), by = b.armY + 4, px = f1(60 - b.hw * 0.4), py = b.top + 12;
    return `<path d="M${bx - 7} ${by - 8} a3.5 3.5 0 0 1 5 -1 a3.5 3.5 0 0 1 5 1 a3.5 3.5 0 0 1 3 5 a3.5 3.5 0 0 1 -1 5 a3.5 3.5 0 0 1 -5 3 a3.5 3.5 0 0 1 -5 -1 z" fill="#fbefd0" stroke="${INK}" stroke-width="1.6" stroke-linejoin="round"/>`
      + `<g transform="rotate(-30 ${px} ${py})"><rect x="${px - 9}" y="${py - 3}" width="18" height="6" rx="2" fill="#f1d9b5" stroke="${INK}" stroke-width="1.5"/><rect x="${px - 3}" y="${py - 9}" width="6" height="18" rx="2" fill="#f1d9b5" stroke="${INK}" stroke-width="1.5"/></g>`;
  }

  /* ── шапки ── */
  function hats(k) {
    const b = k.b, c1 = colorOf(k), c2 = k.c2, t = b.top + 1, hw = b.hw, cx = 60;
    const S = `stroke="${INK}" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"`;
    let leaves = '';
    for (let i = 0; i < 6; i++) for (const sd of [-1, 1]) { const a = (200 + i * 14) * Math.PI / 180, x = f1(cx + sd * Math.cos(a) * -(hw + 5)), y = f1(t + 10 + Math.sin(a) * 12 - i * 1.5); leaves += `<ellipse cx="${x}" cy="${y}" rx="6.5" ry="3.3" transform="rotate(${(sd * (35 - i * 12)).toFixed(0)} ${x} ${y})" fill="${i % 2 ? '#8fd16a' : '#b6e38f'}"/>`; }
    return {

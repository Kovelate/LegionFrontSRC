      crown: `<path d="M${cx - 14} ${t + 6} l0 -17 l7 9 l7 -13 l7 13 l7 -9 l0 17 z" fill="#ffc94d" ${S}/><circle cx="${cx}" cy="${t}" r="2.2" fill="#e8455c"/>`,

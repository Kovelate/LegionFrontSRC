        return `<circle r="15" fill="${hi ? m : '#7a4a2a'}" ${WS}/><path d="M-11 -6 l3 1 M-8 8 l3 -1 M6 -10 l2 2 M10 4 l2 1 M-2 11 l2 1" stroke="rgba(255,255,255,.35)" stroke-width="1.2"/>`
          + `<circle cx="-5" cy="-3" r="2.4" fill="${INK}"/><circle cx="5" cy="-3" r="2.4" fill="${INK}"/><circle cx="0" cy="5" r="2.6" fill="${INK}"/>`;
      case 'buckler':   // крышка от мусорного бака
        return `<circle r="11" fill="${m}" ${WS}/><circle r="8" fill="none" stroke="rgba(0,0,0,.2)" stroke-width="1.4"/><circle r="5" fill="none" stroke="rgba(0,0,0,.2)" stroke-width="1.4"/>`
          + `<rect x="-5" y="-2" width="10" height="4" rx="2" fill="#5a5a66" ${WS}/><path d="M9 -12 l2 -2 M12 -10 l2 -3" stroke="${INK}" stroke-width="1"/><circle cx="13" cy="-13" r="1.4" fill="${INK}"/>`;
      case 'barrel':   // черепаший панцирь
        return `<ellipse rx="14.5" ry="13" fill="${hi ? m : '#6b8f3a'}" ${WS}/>`
          + `<path d="M0 -7 L6 -3 L6 4 L0 8 L-6 4 L-6 -3 Z" fill="#8fb35a" stroke="${INK}" stroke-width="1.4"/><path d="M0 -7 V-13 M6 -3 L12 -6 M6 4 L12 7 M0 8 V13 M-6 4 L-12 7 M-6 -3 L-12 -6" stroke="${INK}" stroke-width="1.4"/>`;

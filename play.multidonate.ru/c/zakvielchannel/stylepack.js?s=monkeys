/* ───── стиль «monkeys»: styles/monkeys/characters.js ───── */
try {
/* Стиль «Злые обезьяны» — сердитые и смешные обезьяны пяти видов «по нику»: макака, горилла, шимпанзе, мандрил, орангутан.
   У многих выпирает красная попа (мандрилы — всегда). 22 окраса шерсти, включая яркие. Общее: сдвинутые брови,
   выпученные разные глаза, растрёпанный хохол и бакенбарды, орущий рот с клыками, улыбка с золотым зубом и щербиной.
   Руки вверх — сжатые кулаки (грозят), руки вниз — до земли. Хвост-завиток покачивается. Окрас и узор — «по нику».
   Устроен как образец styles/legion/characters.js, договор — styles/README.md.
   Холст 120×170, ноги на y = 168, центр по x = 60. Каждая функция возвращает строку SVG. */
(function () {
  'use strict';
  const D = window.MDDoodle;
  if (!D) return;

  // ── цвета стиля ──
  const INK = '#2a1a12';     // обводка
  const FACE = '#e8857a';    // красная кожа морды, ладоней, ушей
  const RAGE = '#e8322a';    // венка злости, злые глаза
  const FUR = [
    '#9c8a72', '#8a7a62', '#b09a78', '#6f6252', '#3a3438', '#55504f', '#8b5a3c', '#a0683f', '#c96f3f', '#d98a3a', '#b8b2a8', '#e8e2d6', '#e0b060', '#7b8a4a',   // природные: бурые, чёрные, рыжие, серебристые, снежные, золотые
    '#5b8fd6', '#8a6ad6', '#4fb08a', '#e06a9a', '#3fa7b5', '#c43d3d', '#d6c24a', '#6a5acd',                                                              // яркие: синий, фиолетовый, мятный, розовый, бирюза, малиновый, жёлтый, индиго
  ];
  const IRIS = ['#6b3b1a', '#8a5a20', '#3d2a1a', '#9a6a2a', '#4f6b2a'];
  const BANANA = '#ffd84a';
  const WS = `stroke="${INK}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"`;
  const RARITY = { common: null, uncommon: '#5bd36a', rare: '#5ec8ff', epic: '#c77dff', legendary: '#ffcf4a' };
  const METAL = { common: '#b7bec4', uncommon: '#cdeec4', rare: '#bfe3ff', epic: '#e0c8ff', legendary: '#ffd76a' };
  const f1 = (v) => +v.toFixed(1);
  // у купленных глаз — цвет как у образца в Шатре (образец: ник «джунгли образец eyes <id>», см. стиль Ярмарки)
  const iris = (k) => IRIS[(((k.look && k.look.eyes ? D.jhash('джунгли образец eyes ' + k.look.eyes) : k.seed) >>> 0) >>> 3) % IRIS.length];
  const FL = `fill="none" stroke="${INK}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"`;

  /* ── тела: (r) → { L, R, top, hw, eyeY, armY, d, square?, narrow?, earX, pat } ──
     earX — расстояние от центра до уха, pat — узор: 0 и 2 гладкий, 1 и 3 светлое брюшко, 4 тёмная шапочка и брюшко; хохол и бакенбарды — всегда */
  const bodies = {
    bean(r) { const w = 25 + Math.floor(r() * 9), L = 60 - w, R = 60 + w, top = 76; return withSp(r, { L, R, top, hw: w * 0.72, eyeY: 100, armY: 114, earX: w + 1, pat: Math.floor(r() * 5), d: `M${L} 168 C${L - 4} 124 ${L + 1} 80 60 ${top} C${R - 1} 80 ${R + 4} 124 ${R} 168 Z` }); },
    box(r) { const w = 24 + Math.floor(r() * 9), L = 60 - w, R = 60 + w, top = 80 + Math.floor(r() * 10); return withSp(r, { L, R, top, hw: w - 4, eyeY: top + 26, armY: top + 36, square: true, earX: w + 1, pat: Math.floor(r() * 5), d: `M${L + 10} ${top} H${R - 10} Q${R} ${top} ${R} ${top + 10} V168 H${L} V${top + 10} Q${L} ${top} ${L + 10} ${top} Z` }); },
    ball(r) { const w = 33 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 98; return withSp(r, { L, R, top, hw: w * 0.62, eyeY: 122, armY: 130, earX: w - 2, pat: Math.floor(r() * 5), d: `M${L + 6} 168 C${L - 8} 150 ${L - 4} ${top} 60 ${top} C${R + 4} ${top} ${R + 8} 150 ${R - 6} 168 Z` }); },
    tall(r) { const w = 19 + Math.floor(r() * 4), L = 60 - w, R = 60 + w, top = 58; return withSp(r, { L, R, top, hw: w * 0.8, eyeY: 82, armY: 98, narrow: true, earX: w + 1, pat: Math.floor(r() * 5), d: `M${L} 168 C${L - 2} 110 ${L} 62 60 ${top} C${R} 62 ${R + 2} 110 ${R} 168 Z` }); },
    ghost(r) { const w = 25 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 78, s = f1((2 * w) / 3); return withSp(r, { L, R, top, hw: w * 0.72, eyeY: 102, armY: 116, earX: w, pat: Math.floor(r() * 5), d: `M${L} 162 C${L} 112 ${L + 2} 82 60 ${top} C${R - 2} 82 ${R} 112 ${R} 162 q${-s / 2} 10 ${-s} 0 q${-s / 2} 10 ${-s} 0 q${-s / 2} 10 ${-s} 0 Z` }); },
    cone(r) { const w = 28 + Math.floor(r() * 6), L = 60 - w, R = 60 + w, top = 72; return withSp(r, { L, R, top, hw: 13, eyeY: 102, armY: 120, narrow: true, earX: 20, pat: Math.floor(r() * 5), d: `M${L} 168 C${L + 4} 140 ${L + 16} 86 60 ${top} C${R - 16} 86 ${R - 4} 140 ${R} 168 Z` }); },
    egg(r) { const w = 27 + Math.floor(r() * 5), L = 60 - w, R = 60 + w, top = 70; return withSp(r, { L, R, top, hw: w * 0.6, eyeY: 98, armY: 116, earX: w - 2, pat: Math.floor(r() * 5), d: `M60 ${top} C${R - 4} ${top} ${R + 6} 130 ${R - 2} 160 Q60 174 ${L + 2} 160 C${L - 6} 130 ${L + 4} ${top} 60 ${top} Z` }); },
  };

  /* ── виды обезьян: выбираются «по нику» внутри тела (r() после узора), хранятся в b.sp ──
     butt — шанс выпирающей красной попы, face — кожа морды и ладоней, ear — размер ушей, tail — есть ли хвост */
  const SPECIES = {
    macaque: { butt: 0.5, face: '#e8857a', ear: 8.5, tail: true },    // красная морда, хохол, бакенбарды
    gorilla: { butt: 0.12, face: '#7a6c72', ear: 6, tail: false },    // гребень на макушке, надбровный валик, широкий нос
    chimp: { butt: 0.15, face: '#ecd2b4', ear: 11.5, tail: false },   // огромные уши, светлая морда, губастая
    mandrill: { butt: 1, face: '#d9c2a0', ear: 7, tail: true },       // красно-синий нос, жёлтая бородка, грива
    orangutan: { butt: 0.15, face: '#a8785e', ear: 6, tail: false },  // щёки-подушки, длинные лохмы
  };
  const SP_IDS = Object.keys(SPECIES);
  const spOf = (b) => SPECIES[b && b.sp] || SPECIES.macaque;
  const skin = (k) => spOf(k.b).face;
  const withSp = (r, o) => { o.sp = SP_IDS[Math.floor(r() * SP_IDS.length)]; o.butt = r() < SPECIES[o.sp].butt; return o; };

  // маска лица: светлые круги вокруг глаз + мордочка (одна форма «арахис»); у шимпанзе и мандрила морда длиннее
  const mask = (k, col) => {
    const { ex, ey, my } = k, re = k.b.narrow ? 8.5 : 9.5, sp = k.b.sp;
    const mx = sp === 'chimp' ? ex + 7 : sp === 'orangutan' ? ex + 6 : ex + 5, myy = sp === 'chimp' ? 11.5 : sp === 'mandrill' ? 12 : 9.5;
    const eyesPart = k.cyc ? `<circle cx="60" cy="${ey - 1}" r="13"/>` : `<circle cx="${60 - ex}" cy="${ey}" r="${re}"/><circle cx="${60 + ex}" cy="${ey}" r="${re}"/>`;
    return `<g fill="${col}">${eyesPart}<ellipse cx="60" cy="${my - 2}" rx="${mx}" ry="${myy}"/></g>`;
  };
  const earsSvg = (k, fill, face, stroke) => {
    const b = k.b, y = b.eyeY + 2, er = spOf(b).ear, x = f1((b.earX || (b.R - b.L) / 2) + (er - 8.5) * 0.6);
    return `<g stroke="${stroke}" stroke-width="2.6"><circle cx="${f1(60 - x)}" cy="${y}" r="${er}" fill="${fill}"/><circle cx="${f1(60 + x)}" cy="${y}" r="${er}" fill="${fill}"/></g><circle cx="${f1(60 - x)}" cy="${y}" r="${f1(er * 0.55)}" fill="${face}"/><circle cx="${f1(60 + x)}" cy="${y}" r="${f1(er * 0.55)}" fill="${face}"/>`;
  };
  // бакенбарды/грива торчком по бокам морды
  const sideburns = (k, col, sc) => {
    const { ex, ey, my } = k, sl = 60 - ex - 9, sr = 60 + ex + 9, z = (v) => f1(v * sc);
    const half = (x0, s) => `M${x0} ${ey - 5} l${z(-9 * s)} ${z(2)} l${z(5 * s)} ${z(4)} l${z(-9 * s)} ${z(4)} l${z(7 * s)} ${z(3)} l${z(-8 * s)} ${z(5)} l${z(10 * s)} 0 l${z(-2 * s)} ${z(4)} L${60 - s * 16} ${my - 1} z`;
    return `<path d="${half(sl, 1)} ${half(sr, -1)}" fill="${col}" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>`;
  };

  // тело: красная попа → хвост → уши → контур → узор → причёска вида → маска → нос
  function body(k) {
    const b = k.b, fill = k.fill, pat = b.pat || 0, sp = b.sp || 'macaque', S = spOf(b), face = S.face;
    const t = b.top, ex = k.ex, ey = k.ey, my = k.my;
    let s = '';
    if (b.butt) {   // выпирающая красная попа: две половинки торчат по бокам у земли, с бликом
      const yl = 154, L = b.L, R = b.R;
      s += `<g fill="#e8384f" stroke="${INK}" stroke-width="2.6"><ellipse cx="${L - 2}" cy="${yl}" rx="14" ry="14.5"/><ellipse cx="${R + 2}" cy="${yl}" rx="14" ry="14.5"/></g>`
        + `<path d="M${L - 11} ${yl - 5} q3 -6 9 -7 M${R + 11} ${yl - 5} q-3 -6 -9 -7" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>`;
    }
    if (S.tail) {
      const bx = b.R - 6, by = 156, beg = (((k.seed >>> 0) % 997) / 997 * 3).toFixed(2);
      const T = sp === 'mandrill' ? `M${bx} ${by} C${bx + 12} ${by - 2} ${bx + 16} ${by - 10} ${bx + 14} ${by - 18}`
        : `M${bx} ${by} C${bx + 20} ${by + 4} ${bx + 30} ${by - 14} ${bx + 24} ${by - 34} C${bx + 20} ${by - 48} ${bx + 6} ${by - 46} ${bx + 8} ${by - 36} C${bx + 10} ${by - 28} ${bx + 20} ${by - 32} ${bx + 18} ${by - 38}`;
      s += `<g><animateTransform attributeName="transform" type="rotate" values="-5 ${bx} ${by};7 ${bx} ${by};-5 ${bx} ${by}" dur="3s" begin="-${beg}s" repeatCount="indefinite"/>`
        + `<path d="${T}" fill="none" stroke="${INK}" stroke-width="8.5" stroke-linecap="round"/><path d="${T}" fill="none" stroke="${fill}" stroke-width="4.5" stroke-linecap="round"/></g>`;
    }
    s += earsSvg(k, fill, face, INK);
    s += `<path d="${b.d}" fill="${fill}" stroke="${INK}" stroke-width="3" stroke-linejoin="round"/>`;
    if (pat === 1 || pat === 3 || pat === 4 || sp === 'gorilla') {
      const c = k.uid('jlP');
      s += `<defs><clipPath id="${c}"><path d="${b.d}"/></clipPath></defs><g clip-path="url(#${c})">`
        + (pat === 4 || sp === 'gorilla' ? `<ellipse cx="60" cy="${t + 4}" rx="${f1((b.R - b.L) * 0.6)}" ry="${f1((b.eyeY - t) * 0.75)}" fill="rgba(30,15,5,.25)"/>` : '')
        + (pat === 1 || pat === 3 || pat === 4 ? `<ellipse cx="60" cy="${f1((b.armY + 168) / 2 + 10)}" rx="${f1((b.R - b.L) * 0.28)}" ry="${f1((168 - b.armY) / 2)}" fill="#d8c8a8" opacity=".75"/>` : '')
        + (sp === 'gorilla' ? `<path d="M${b.L - 4} ${b.armY + 6} q8 -4 14 4 M${b.R + 4} ${b.armY + 6} q-8 -4 -14 4" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="5" stroke-linecap="round"/>` : '')
        + '</g>';
    }
    // причёска и черты вида
    if (sp === 'macaque') s += `<path d="M49 ${t + 7} l-5 -11 l8 5 l1 -12 l5 9 l3 -13 l3 12 l6 -10 l0 13 l7 -6 l-4 12 z" fill="${fill}" stroke="${INK}" stroke-width="2.2" stroke-linejoin="round"/>` + sideburns(k, '#d8c8a8', 1);
    else if (sp === 'gorilla') s += `<path d="M${f1(60 - b.hw * 0.7)} ${t + 9} Q60 ${t - 16} ${f1(60 + b.hw * 0.7)} ${t + 9} Z" fill="${fill}" stroke="${INK}" stroke-width="2.4" stroke-linejoin="round"/><path d="M${f1(60 - b.hw * 0.5)} ${t + 6} Q60 ${t - 8} ${f1(60 + b.hw * 0.5)} ${t + 6}" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="3"/>`;   // сагиттальный гребень
    else if (sp === 'chimp') s += `<path d="M53 ${t + 6} q2 -9 7 -11 q-1 6 0 10 q3 -7 8 -8 q-2 5 -3 9 z" fill="${fill}" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>`;
    else if (sp === 'mandrill') s += sideburns(k, '#c9b26a', 1.3) + `<path d="M50 ${t + 6} l-2 -9 l6 4 l3 -8 l3 8 l3 -8 l3 8 l6 -4 l-2 9 z" fill="#c9b26a" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>`;
    else if (sp === 'orangutan') {   // длинные лохмы и щёки-подушки
      s += `<path d="M44 ${t + 10} q-8 -14 -4 -22 q4 8 10 12 q-2 -12 4 -18 q2 10 6 14 q2 -12 9 -16 q-1 10 1 15 q6 -8 13 -8 q-5 6 -6 14 q8 -2 12 4 q-8 0 -12 6 z" fill="${fill}" stroke="${INK}" stroke-width="2.2" stroke-linejoin="round"/>`
        + `<ellipse cx="${60 - ex - 11}" cy="${ey + 5}" rx="8" ry="13" fill="#8a5c46" stroke="${INK}" stroke-width="2.2"/><ellipse cx="${60 + ex + 11}" cy="${ey + 5}" rx="8" ry="13" fill="#8a5c46" stroke="${INK}" stroke-width="2.2"/>`;
    }
    s += mask(k, face);
    if (sp === 'gorilla') s += `<path d="M${60 - ex - 10} ${ey - 6} Q60 ${ey - 17} ${60 + ex + 10} ${ey - 6} Q60 ${ey - 11} ${60 - ex - 10} ${ey - 6} Z" fill="#4a3f45"/>`   // надбровный валик
      + `<path d="M55 ${my - 10} q5 -3 10 0 q2 4 -1 5 q-4 1 -8 0 q-3 -1 -1 -5 z" fill="#4a3f45" stroke="${INK}" stroke-width="1.2"/><ellipse cx="57.6" cy="${my - 7}" rx="1.6" ry="1.3" fill="${INK}"/><ellipse cx="62.4" cy="${my - 7}" rx="1.6" ry="1.3" fill="${INK}"/>`;
    else if (sp === 'mandrill') s += `<path d="M53 ${my - 13} q-3 6 0 9 M67 ${my - 13} q3 6 0 9" fill="none" stroke="#4f8fe0" stroke-width="4" stroke-linecap="round"/><path d="M58 ${my - 16} h4 l1 10 q-3 2 -6 0 z" fill="#e8384f" stroke="${INK}" stroke-width="1.2"/>`
      + `<path d="M54 ${my + 7} l2 7 l2 -4 l2 6 l2 -6 l2 4 l2 -7 z" fill="#ffd23f" stroke="${INK}" stroke-width="1.2" stroke-linejoin="round"/><ellipse cx="58.3" cy="${my - 6}" rx="1" ry="1.4" fill="${INK}"/><ellipse cx="61.7" cy="${my - 6}" rx="1" ry="1.4" fill="${INK}"/>`;
    else s += `<ellipse cx="57.6" cy="${my - 8}" rx="1.2" ry="1.7" fill="${INK}"/><ellipse cx="62.4" cy="${my - 8}" rx="1.2" ry="1.7" fill="${INK}"/>`;
    return s;
  }

  /* ── лицо: у макак всегда сдвинутые брови, глаза выпучены и разные ── */
  const eyeBall = (x, y, rr, col, px = 0, py = 0, pr = 0.3) => `<circle cx="${x}" cy="${y}" r="${rr}" fill="#fff" stroke="${INK}" stroke-width="1.8"/>${col ? `<circle cx="${f1(x + px)}" cy="${f1(y + py)}" r="${f1(rr * 0.55)}" fill="${col}"/>` : ''}<circle cx="${f1(x + px)}" cy="${f1(y + py)}" r="${f1(rr * pr)}" fill="${INK}"/>`;
  const starP = (x, y, rr) => { let d = ''; for (let i = 0; i < 10; i++) { const a = (i * 36 - 90) * Math.PI / 180, q = i % 2 ? rr * 0.45 : rr; d += `${i ? 'L' : 'M'}${f1(x + Math.cos(a) * q)} ${f1(y + Math.sin(a) * q)}`; } return d + 'Z'; };
  const dot = (x, y, rx = 3.4, ry = 4) => `<ellipse cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" fill="${INK}"/><circle cx="${f1(x - 1.1)}" cy="${f1(y - 1.5)}" r="1.2" fill="#fff"/>`;
  const BW = `fill="none" stroke="${INK}" stroke-width="3.4" stroke-linecap="round"`;
  // злые брови: внутренние концы вниз; правая чуть выше — так смешнее
  const brows = (k, lift = 0) => k.cyc ? `<path d="M46 ${k.ey - 15} L60 ${k.ey - 8} L74 ${k.ey - 15 - lift}" ${BW}/>`
    : `<path d="M${60 - k.ex - 8} ${k.ey - 12} l12 6 M${60 + k.ex + 8} ${k.ey - 13 - lift} l-12 6" ${BW}/>`;
  const vein = (k) => { const x = f1(60 + k.b.hw * 0.5), y = k.b.top + 14; return `<path d="M${x - 5} ${y - 2} q3 0 3 -3 M${x + 2} ${y - 5} q0 3 3 3 M${x + 5} ${y + 2} q-3 0 -3 3 M${x - 2} ${y + 5} q0 -3 -3 -3" fill="none" stroke="${RAGE}" stroke-width="2.4" stroke-linecap="round"/>`; };
  function eyes(kind, k) {
    const { ex, ey } = k, xs = [60 - ex, 60 + ex], col = iris(k);
    if (kind === 'dots') return xs.map((x) => dot(x, ey + 1, 3, 3.6)).join('') + brows(k);
    if (kind === 'big') return eyeBall(xs[0], ey, 6.8, null, 1.5, 1, 0.24) + eyeBall(xs[1], ey + 1, 5, null, -1, -1.2, 0.3) + brows(k, 3);   // выпученные, смотрят в разные стороны
    if (kind === 'crazy' || kind === 'curious') return eyeBall(xs[0], ey + 1, 4, null, 0, 0, 0.4) + eyeBall(xs[1], ey - 1, 8, col, 0, 0, 0.18) + `<path d="M${xs[0] - 7} ${ey - 9} l11 5 M${xs[1] - 6} ${ey - 13} q6 -5 12 0" ${BW}/>`;   // один глаз огромный
    if (kind === 'mad') return xs.map((x) => eyeBall(x, ey, 5.6, RAGE, 0, 0.5, 0.2)).join('') + brows(k);
    if (kind === 'cyclops') return eyeBall(60, ey - 1, 9.5, col, 0, 0, 0.18) + brows(k, 2);
    if (kind === 'stars') return `<path d="${starP(xs[0], ey, 5.6)}${starP(xs[1], ey, 5.6)}" fill="#ffd23f" stroke="${INK}" stroke-width="1.5" stroke-linejoin="round"/>` + brows(k);
    if (kind === 'sleepy') return xs.map((x) => `<path d="M${x - 5.5} ${ey} a5.5 5 0 0 0 11 0 z" fill="#fff" stroke="${INK}" stroke-width="1.6"/><circle cx="${x}" cy="${ey + 1.8}" r="2.2" fill="${INK}"/><path d="M${x - 6.5} ${ey} h13" ${BW}/>`).join('') + brows(k);   // тяжёлый недобрый взгляд
    // happy → самодовольный прищур
    return xs.map((x) => `<path d="M${x - 5} ${ey - 1} h10 a5 4 0 0 1 -10 0 z" fill="${INK}"/>`).join('') + brows(k, 2);
  }
  function mouth(kind, k) {
    const my = k.my;
    if (kind === 'open') return `<path d="M49 ${my - 3} Q60 ${my + 19} 71 ${my - 3} Q60 ${my - 1} 49 ${my - 3} Z" fill="#6a1f2c" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>`   // орёт «А-А-А»
      + `<path d="M52 ${my - 2} l2 7 l3 -6.6 z M68 ${my - 2} l-2 7 l-3 -6.6 z" fill="#fff" stroke="${INK}" stroke-width="1.2" stroke-linejoin="round"/><ellipse cx="60" cy="${my + 9}" rx="4.6" ry="2.4" fill="#ff8fa3"/>`;
    if (kind === 'grin') return `<path d="M49 ${my - 3} Q60 ${my + 11} 71 ${my - 3} Z" fill="#fff" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/>`   // зубастая ухмылка: щербина и золотой зуб
      + `<rect x="57.4" y="${my - 2.6}" width="4.6" height="5.6" fill="#3a1218"/><rect x="62.2" y="${my - 2.6}" width="4.4" height="5" fill="#ffd23f"/><path d="M50.5 ${my - 0.3} Q60 ${my + 1.6} 69.5 ${my - 0.3} M53 ${my - 2.6} v5 M57.4 ${my - 2.6} v6 M62.2 ${my - 2.6} v6 M66.6 ${my - 2.6} v5" fill="none" stroke="${INK}" stroke-width="1.1"/>`;
    // tongue → дразнится: язык вбок, брызги
    return `<path d="M51 ${my - 1} q4 3 9 0 q5 -3 9 0" ${FL}/><path d="M58 ${my} q6 2 9 9 q-4 3 -8 -1 q-2 -4 -1 -8 z" fill="#ff7f9a" stroke="${INK}" stroke-width="1.4" stroke-linejoin="round"/><circle cx="72" cy="${my + 2}" r="1.2" fill="#bfe8ff"/><circle cx="74" cy="${my - 2}" r="0.9" fill="#bfe8ff"/>`;
  }
  const faces = {
    sad(k) {   // дуется: мокрые глаза, бровки злым домиком, губа вперёд, слеза
      const { ex, ey, my } = k;
      const big = (x, y, rr) => `<circle cx="${x}" cy="${y}" r="${rr}" fill="${INK}"/><circle cx="${f1(x - rr * 0.35)}" cy="${f1(y - rr * 0.35)}" r="${f1(rr * 0.36)}" fill="#fff"/>`;
      const e = (k.cyc ? big(60, ey - 1, 8) + `<path d="M48 ${ey - 12} q12 -6 24 0" ${BW}/>`
        : big(60 - ex, ey + 1, 5) + big(60 + ex, ey + 1, 5) + `<path d="M${60 - ex - 7} ${ey - 6} l10 -5 M${60 + ex + 7} ${ey - 6} l-10 -5" ${BW}/>`)
        + `<path class="tear" d="M${60 + ex + 4} ${ey + 6} q-3 6 0 8 q3 -2 0 -8 z" fill="#8fd3ff" stroke="${INK}" stroke-width="1.2"/>`;
      return { eyes: e, mouth: `<ellipse cx="60" cy="${my + 3}" rx="6" ry="3.4" fill="#c4505a" stroke="${INK}" stroke-width="1.8"/><path d="M52 ${my + 1} q8 -6 16 0" ${FL}/>` };
    },
    chill(k) {   // самодовольный: веки прикрыты, одна бровь вверх, хитрая ухмылка набок
      const { ex, ey, my } = k;
      const lid = (x) => `<path d="M${x - 5.5} ${ey} a5.5 5 0 0 0 11 0 z" fill="#fff" stroke="${INK}" stroke-width="1.6"/><circle cx="${x + 1.5}" cy="${ey + 2}" r="2" fill="${INK}"/><path d="M${x - 6.5} ${ey} h13" ${FL}/>`;
      return { eyes: k.cyc ? lid(60) + `<path d="M50 ${ey - 12} q10 -6 20 0" ${BW}/>` : lid(60 - ex) + lid(60 + ex) + `<path d="M${60 - ex - 7} ${ey - 8} l11 3 M${60 + ex - 6} ${ey - 11} q6 -5 12 0" ${BW}/>`,
        mouth: `<path d="M51 ${my} q9 3 18 -4" ${FL}/>` };
    },
    stern(k) {   // в ярости: крохотные зрачки, брови углом, оскал с клыками, венка на лбу
      const { ex, ey, my } = k;
      return { eyes: (k.cyc ? eyeBall(60, ey - 1, 9, RAGE, 0, 0, 0.15) : eyeBall(60 - ex, ey + 1, 5.6, null, 0, 0, 0.2) + eyeBall(60 + ex, ey + 1, 5.6, null, 0, 0, 0.2)) + brows(k) + vein(k),
        mouth: `<path d="M49 ${my - 3} Q60 ${my + 2} 71 ${my - 3} Q71 ${my + 6} 60 ${my + 6} Q49 ${my + 6} 49 ${my - 3} Z" fill="#fff" stroke="${INK}" stroke-width="2" stroke-linejoin="round"/><path d="M49.5 ${my + 1.5} H70.5 M54 ${my - 1.5} v7 M58 ${my - 0.5} v6.5 M62 ${my - 0.5} v6.5 M66 ${my - 1.5} v7" stroke="${INK}" stroke-width="1"/><path d="M51 ${my - 2} l2 6 l2.5 -5.4 z M69 ${my - 2} l-2 6 l-2.5 -5.4 z" fill="#fff" stroke="${INK}" stroke-width="1.2" stroke-linejoin="round"/>` };
    },
    hurt(k) {   // побит, но зол: глаз крестиком, второй бешеный, рот кривой с выбитым зубом
      const { ex, ey, my } = k;
      return { eyes: k.cyc ? `<path d="M52 ${ey - 8} l16 12 M68 ${ey - 8} l-16 12" ${FL}/>` + brows(k)
        : `<path d="M${60 - ex - 4} ${ey - 4} l8 8 M${60 - ex + 4} ${ey - 4} l-8 8" ${FL}/>${eyeBall(60 + ex, ey + 1, 5.4, null, 0, 0, 0.2)}<path d="M${60 + ex + 8} ${ey - 12} l-12 6" ${BW}/>`,
        mouth: `<path d="M51 ${my + 3} q4 -6 9 -2 q5 3 9 -3 l0 3 q-5 6 -9 3 q-5 -3 -9 2 z" fill="#fff" stroke="${INK}" stroke-width="1.8" stroke-linejoin="round"/><rect x="59" y="${my - 1.6}" width="3.4" height="3.6" fill="#3a1218"/>` };
    },
  };
  const blush = (k) => `<ellipse cx="${60 - k.ex - 7}" cy="${k.my - 3}" rx="4" ry="2.4" fill="#c42a2a" opacity=".35"/><ellipse cx="${60 + k.ex + 7}" cy="${k.my - 3}" rx="4" ry="2.4" fill="#c42a2a" opacity=".35"/>`;
  function hurt(k) {
    const b = k.b, px = f1(60 + b.hw * 0.45), py = b.square ? b.top + 8 : b.top + 12;
    return `<g transform="rotate(35 ${px} ${py})"><rect x="${px - 9}" y="${py - 3}" width="18" height="6" rx="2" fill="#f1d9b5" stroke="${INK}" stroke-width="1.5"/><rect x="${px - 3}" y="${py - 9}" width="6" height="18" rx="2" fill="#f1d9b5" stroke="${INK}" stroke-width="1.5"/></g>`
      + `<circle cx="${60 - k.ex - 7}" cy="${k.ey + 9}" r="4.5" fill="#8a5ab8" opacity=".45"/>`;
  }

  /* ── шапки ── */
  function hats(k) {
    const b = k.b, c1 = k.fill, c2 = k.c2, t = b.square ? b.top - 4 : b.top + 1, hw = b.hw, cx = 60;
    const S = `stroke="${INK}" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"`;
    let leaves = '';
    for (let i = 0; i < 6; i++) for (const sd of [-1, 1]) { const a = (200 + i * 14) * Math.PI / 180, x = f1(cx + sd * Math.cos(a) * -(hw + 5)), y = f1(t + 10 + Math.sin(a) * 12 - i * 1.5); leaves += `<ellipse cx="${x}" cy="${y}" rx="6.5" ry="3.3" transform="rotate(${(sd * (35 - i * 12)).toFixed(0)} ${x} ${y})" fill="${i % 2 ? '#8fd16a' : '#b6e38f'}"/>`; }
    return {
      none: '',
      tuft: `<path d="M${cx - 5} ${t + 3} q-3 -9 -9 -11 q6 -1 10 5 q-1 -9 3 -13 q3 6 2 13 q4 -7 10 -7 q-4 4 -6 13 z" fill="${c1}" ${S}/>`,
      cap: `<path d="M${f1(cx - hw - 2)} ${t + 12} q${f1(hw + 2)} -26 ${f1(2 * hw + 4)} 0 z" fill="${c2}" ${S}/><path d="M${f1(cx + hw - 2)} ${t + 10} q10 -2 16 3 q-8 3 -16 1 z" fill="${c2}" ${S}/>`,
      bow: `<path d="M${cx} ${t + 3} l-12 -8 l1 15 z M${cx} ${t + 3} l12 -8 l-1 15 z" fill="${c2}" ${S}/><circle cx="${cx}" cy="${t + 3}" r="3" fill="${c2}" ${S}/>`,
      horns: `<path d="M${f1(cx - hw * 0.55)} ${t + 7} q-10 -8 -6 -22 q6 10 13 16 z M${f1(cx + hw * 0.55)} ${t + 7} q10 -8 6 -22 q-6 10 -13 16 z" fill="#e8455c" ${S}/>`,
      crown: `<path d="M${cx - 14} ${t + 6} l0 -17 l7 9 l7 -13 l7 13 l7 -9 l0 17 z" fill="#ffc94d" ${S}/><circle cx="${cx}" cy="${t}" r="2.2" fill="#e8455c"/>`,
      tophat: `<rect x="${cx - 12}" y="${t - 24}" width="24" height="28" rx="2" fill="#2a2440" ${S}/><rect x="${cx - 20}" y="${t + 2}" width="40" height="4.5" rx="2" fill="#2a2440" ${S}/><path d="M${cx - 11} ${t - 3} h22" stroke="${c2}" stroke-width="4.5"/>`,
      party: `<path d="M${cx - 12} ${t + 6} L${cx} ${t - 30} L${cx + 12} ${t + 6} z" fill="${c2}" ${S}/><circle cx="${cx}" cy="${t - 32}" r="4.5" fill="#fff" ${S}/><circle cx="${cx - 3}" cy="${t - 4}" r="2" fill="#fff"/><circle cx="${cx + 4}" cy="${t - 14}" r="2" fill="#fff"/>`,
      wizard: `<path d="M${f1(cx - hw - 6)} ${t + 10} L${cx + 4} ${t - 38} Q${cx + 12} ${t - 34} ${cx + 20} ${t - 28} L${f1(cx + hw + 6)} ${t + 10} z" fill="#4b3bb8" ${S}/><path d="${starP(cx + 1, t - 10, 5)}" fill="#ffc94d"/>`,
      antenna: `<path d="M${cx} ${t} q-6 -14 4 -24" ${FL}/><circle cx="${cx + 4}" cy="${t - 27}" r="5.5" fill="${c2}" ${S}/>`,
      antenna2: `<path d="M${cx - 6} ${t + 2} l-8 -20 M${cx + 6} ${t + 2} l8 -20" ${FL}/><circle cx="${cx - 14}" cy="${t - 20}" r="5" fill="${c2}" ${S}/><circle cx="${cx + 14}" cy="${t - 20}" r="5" fill="${c2}" ${S}/>`,
      cat: `<path d="M${f1(cx - hw)} ${t + 12} l2 -22 l13 13 z M${f1(cx + hw)} ${t + 12} l-2 -22 l-13 13 z" fill="${c1}" ${S}/><path d="M${f1(cx - hw + 3)} ${t + 7} l1 -10 l6 6 z M${f1(cx + hw - 3)} ${t + 7} l-1 -10 l-6 6 z" fill="#ff9fb4"/>`,
      bunny: `<ellipse cx="${cx - 9}" cy="${t - 16}" rx="6" ry="18" fill="#f7f2ee" ${S}/><ellipse cx="${cx + 9}" cy="${t - 16}" rx="6" ry="18" fill="#f7f2ee" ${S}/><ellipse cx="${cx - 9}" cy="${t - 15}" rx="2.6" ry="12" fill="#ff9fb4"/><ellipse cx="${cx + 9}" cy="${t - 15}" rx="2.6" ry="12" fill="#ff9fb4"/>`,
      halo: `<ellipse cx="${cx}" cy="${t - 14}" rx="17" ry="5" fill="none" stroke="#ffe27a" stroke-width="3.8"/>`,
      sprout: `<path d="M${cx} ${t + 1} q-1 -10 2 -16" fill="none" stroke="#3d7a2a" stroke-width="2.4" stroke-linecap="round"/><path d="M${cx + 2} ${t - 15} q-16 -6 -20 4 q12 -6 20 -4 z M${cx + 2} ${t - 15} q14 -9 20 2 q-11 -5 -20 -2 z M${cx + 2} ${t - 15} q-2 -14 8 -16 q-7 6 -8 16 z" fill="#5fc25f" ${S}/>`,   // пальмовый росток
      bandana: `<path d="M${f1(cx - hw - 2)} ${t + 16} Q${cx} ${t - 6} ${f1(cx + hw + 2)} ${t + 16} Z" fill="#e8455c" ${S}/><path d="M${f1(cx + hw)} ${t + 14} l12 -2 l-4 10 z" fill="#e8455c" ${S}/><circle cx="${cx - 6}" cy="${t + 7}" r="1.5" fill="#fff"/><circle cx="${cx + 6}" cy="${t + 5}" r="1.5" fill="#fff"/><circle cx="${cx}" cy="${t + 10}" r="1.5" fill="#fff"/>`,
      legion: `<path d="M${f1(cx - hw - 5)} ${t + 16} Q${f1(cx - hw - 5)} ${t - 15} ${cx} ${t - 15} Q${f1(cx + hw + 5)} ${t - 15} ${f1(cx + hw + 5)} ${t + 16} L${f1(cx + hw - 2)} ${t + 16} L${f1(cx + hw - 2)} ${t + 8} L${f1(cx - hw + 2)} ${t + 8} L${f1(cx - hw + 2)} ${t + 16} Z" fill="#d9b04a" ${S}/>`
        + `<path d="M${cx - 17} ${t - 13} Q${cx - 13} ${t - 39} ${cx} ${t - 40} Q${cx + 13} ${t - 39} ${cx + 17} ${t - 13} Z" fill="#e8455c" ${S}/><path d="M${cx - 8} ${t - 31} v14 M${cx} ${t - 35} v18 M${cx + 8} ${t - 31} v14" stroke="#a3122a" stroke-width="2.2"/>`,
      laurel: `<g stroke="#2f5a24" stroke-width="1.4">${leaves}</g>`,
      beret: `<ellipse cx="${cx - 4}" cy="${t + 2}" rx="${f1(hw + 7)}" ry="9.5" transform="rotate(-8 ${cx} ${t})" fill="${c2}" ${S}/><path d="M${cx - 2} ${t - 7} l3 -7" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>`,
      headphones: `<path d="M${f1(cx - hw - 6)} ${b.eyeY - 4} Q${f1(cx - hw - 6)} ${t - 14} ${cx} ${t - 14} Q${f1(cx + hw + 6)} ${t - 14} ${f1(cx + hw + 6)} ${b.eyeY - 4}" fill="none" stroke="#2a2440" stroke-width="5" stroke-linecap="round"/>`
        + `<rect x="${f1(cx - hw - 13)}" y="${b.eyeY - 14}" width="12" height="20" rx="5" fill="${c2}" ${S}/><rect x="${f1(cx + hw + 1)}" y="${b.eyeY - 14}" width="12" height="20" rx="5" fill="${c2}" ${S}/>`,
      cowboy: `<path d="M${cx - 17} ${t + 5} q-4 -28 17 -32 q21 4 17 32 z" fill="#a0703a" ${S}/><path d="M${cx - 36} ${t + 2} q36 18 72 0 q-8 12 -36 13 q-28 -1 -36 -13 z" fill="#8a5a2b" ${S}/><path d="M${cx - 16} ${t - 3} h32" stroke="#e8455c" stroke-width="4.5"/>`,
      chef: `<path d="M${cx - 13} ${t + 6} v-13 q-12 -2 -8 -14 q4 -10 14 -4 q4 -10 12 -2 q10 -4 12 6 q2 10 -10 14 v13 z" fill="#fff" ${S}/><path d="M${cx - 13} ${t + 1} h26" stroke="${INK}" stroke-width="1.4"/>`,
    };

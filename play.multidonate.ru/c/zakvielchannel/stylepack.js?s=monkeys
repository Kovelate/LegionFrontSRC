  /* ── снаряжение ── */
  const banana = (x, y, s, col) => `<path d="M${f1(x - s)} ${y} C${f1(x - s * 0.6)} ${f1(y + s * 0.9)} ${f1(x + s * 0.6)} ${f1(y + s * 0.9)} ${f1(x + s)} ${f1(y - s * 0.3)} C${f1(x + s * 0.3)} ${f1(y + s * 0.35)} ${f1(x - s * 0.4)} ${f1(y + s * 0.3)} ${f1(x - s)} ${y} Z" fill="${col}"/>`;
  // оружие обезьян: рукоять в (0,0), «клинок» вверх (−y). Начальное снаряжение — забавное: банан, тапок, кокос, грабли…
  // обычное — своего цвета; редкое, эпическое и легендарное — окрашено «металлом» редкости (и светится — это делает скелет)
  function weapon(kind, rar) {
    const m = METAL[rar] || METAL.common, hi = rar && rar !== 'common', wood = '#8a5a2b', dw = '#5a3a1c';
    const grip = (y0, y1, w = 5, c = wood) => `<rect x="${-w / 2}" y="${y1}" width="${w}" height="${y0 - y1}" rx="2" fill="${c}" ${WS}/>`;
    const line = (d, c = INK, w = 1.6) => `<path d="${d}" fill="none" stroke="${c}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"/>`;
    switch (kind) {
      case 'sword': {   // банан-меч: держат за черешок
        const c = hi ? m : BANANA;
        return `<rect x="-2.5" y="2" width="5" height="9" rx="2" fill="#6b4a2a" ${WS}/><path d="M-4 3 C-14 -14 -12 -42 4 -60 C1 -42 2 -16 6 2 Z" fill="${c}" ${WS}/>`
          + line('M-1 0 C-8 -16 -7 -38 3 -54', 'rgba(150,100,0,.45)', 1.6) + `<path d="M4 -60 l2 -4" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>`
          + `<circle cx="-5" cy="-24" r="1.4" fill="#6b4a2a" opacity=".6"/><circle cx="-3" cy="-36" r="1.1" fill="#6b4a2a" opacity=".6"/>`;
      }
      case 'gladius': {   // боевой тапок
        const c = hi ? m : '#4a7fd0';
        return `<path d="M-7 5 C-10 -10 -10 -34 -5 -45 C1 -52 9 -45 9 -34 C10 -14 9 -2 7 5 Q0 8 -7 5 Z" fill="${c}" ${WS}/>`
          + `<path d="M-9 -30 Q0 -38 10 -30 L9 -22 Q0 -29 -9 -22 Z" fill="#fff" ${WS}/>` + line('M-4 -6 h8 M-5 2 h10', 'rgba(0,0,0,.25)', 1.4)
          + `<circle cx="1" cy="-40" r="2.2" fill="#ffd84a" stroke="${INK}" stroke-width="1"/>`;
      }
      case 'dagger': {   // колючая веточка
        const c = hi ? m : '#7a5230';
        return `<path d="M0 10 C-1 -4 2 -18 1 -32" fill="none" stroke="${INK}" stroke-width="6.5" stroke-linecap="round"/><path d="M0 10 C-1 -4 2 -18 1 -32" fill="none" stroke="${c}" stroke-width="3.6" stroke-linecap="round"/>`
          + `<path d="M0 -4 l-6 -3 l5 -2 Z M1 -14 l6 -4 l-5 -1 Z M1 -24 l-6 -3 l5 -2 Z" fill="#e8d6a8" stroke="${INK}" stroke-width="1.2" stroke-linejoin="round"/>`
          + `<path d="M1 -32 q8 -8 12 -2 q-6 6 -12 2 z" fill="#5aa84a" ${WS}/>`;
      }
      case 'axe': {   // топорик из половинки кокоса
        const c = hi ? m : '#7a4a2a';
        return `${grip(14, -50)}<path d="M2 -52 C18 -56 25 -42 23 -26 C17 -30 9 -32 2 -30 Z" fill="${c}" ${WS}/>`
          + line('M22 -28 C23 -40 17 -51 5 -51', '#f4efe4', 2.6) + line('M8 -46 l3 2 M12 -40 l3 1 M8 -36 l3 1 M15 -48 l2 2', 'rgba(255,255,255,.35)', 1.2);
      }
      case 'club': {   // ананас на палке
        const c = hi ? m : '#f5b83a';
        let hatch = ''; for (let i = -2; i <= 2; i++) hatch += line(`M${i * 5 - 6} -54 L${i * 5 + 6} -28 M${i * 5 + 6} -54 L${i * 5 - 6} -28`, 'rgba(120,70,0,.45)', 1.2);
        return `${grip(12, -26, 5)}<ellipse cy="-41" rx="10" ry="15" fill="${c}" ${WS}/>${hatch}<ellipse cy="-41" rx="10" ry="15" fill="none" ${WS}/>`
          + `<path d="M0 -56 L-8 -70 L-2 -62 L0 -74 L2 -62 L8 -70 Z" fill="#5aa84a" ${WS}/>`;
      }
      case 'mace': return `${grip(12, -32)}${[0, 60, 120, 180, 240, 300].map((a) => { const q = a * Math.PI / 180, s = Math.sin(q), c = Math.cos(q); return `<path d="M${f1(s * 8 - c * 3)} ${f1(-42 - c * 8 - s * 3)} L${f1(s * 14)} ${f1(-42 - c * 14)} L${f1(s * 8 + c * 3)} ${f1(-42 - c * 8 + s * 3)} Z" fill="${m}" ${WS}/>`; }).join('')}<circle cy="-42" r="9.5" fill="${hi ? m : '#7a4a2a'}" ${WS}/><circle cx="-3" cy="-44" r="1.4" fill="${INK}"/><circle cx="3" cy="-44" r="1.4" fill="${INK}"/><circle cy="-39" r="1.4" fill="${INK}"/>`;   // кокос с шипами   // оставлено из прежнего стиля
      case 'hammer': {   // булыжник, примотанный лианой
        const c = hi ? m : '#9a958c';
        return `${grip(14, -38)}<path d="M-15 -55 Q-18 -40 -7 -38 L8 -37 Q17 -41 15 -55 Q2 -62 -15 -55 Z" fill="${c}" ${WS}/>`
          + `<path d="M-3 -38 l-2 -18 M3 -37 l2 -19" stroke="#5aa84a" stroke-width="3" stroke-linecap="round"/><circle cx="-9" cy="-50" r="1.6" fill="rgba(0,0,0,.25)"/><circle cx="9" cy="-46" r="1.2" fill="rgba(0,0,0,.25)"/>`;
      }
      case 'spear': {   // сахарный тростник
        const c = hi ? m : '#c9b560';
        let nodes = ''; for (let y = -58; y <= 24; y += 14) nodes += `<path d="M-3 ${y} h6" stroke="${INK}" stroke-width="1.8"/>`;
        return `<rect x="-3" y="-66" width="6" height="98" rx="2" fill="${c}" ${WS}/>${nodes}<path d="M-3 -66 L3 -80 L3 -66 Z" fill="#e8e0b0" ${WS}/>`
          + `<path d="M3 -60 q12 -10 16 -26 q-12 6 -16 26 z" fill="#5aa84a" ${WS}/>`;
      }
      case 'pitchfork': {   // грабли (на которые лучше не наступать)
        const c = hi ? m : '#9aa1a8';
        let teeth = ''; for (let i = 0; i < 6; i++) { const x = -13 + i * 5.2; teeth += `<path d="M${x} -58 V-70" stroke="${INK}" stroke-width="5" stroke-linecap="round"/><path d="M${x} -58 V-70" stroke="${c}" stroke-width="2.4" stroke-linecap="round"/>`; }
        return `<rect x="-2.5" y="-56" width="5" height="88" rx="2" fill="${wood}" ${WS}/>${teeth}<rect x="-16" y="-61" width="32" height="6" rx="2" fill="${c}" ${WS}/>`
          + `<path d="M8 -20 l4 -3 M10 -14 l5 -2" stroke="${INK}" stroke-width="1.4" stroke-linecap="round"/>`;
      }
      case 'bow': {   // плевательная трубка с дротиком
        const c = hi ? m : '#c9b560';
        return `<rect x="-3" y="-46" width="6" height="86" rx="3" fill="${c}" ${WS}/><path d="M-3 -16 h6 M-3 14 h6" stroke="${INK}" stroke-width="1.6"/>`
          + `<rect x="-4" y="34" width="8" height="8" rx="2" fill="#7a4a2a" ${WS}/><path d="M0 -46 V-56" stroke="${INK}" stroke-width="1.6"/><path d="M0 -56 l-4 -6 h8 Z" fill="#e8322a" ${WS}/>`;
      }
      case 'staff': { const top = hi ? `<path d="M0 -84 L8 -70 L0 -58 L-8 -70 Z" fill="${RARITY[rar]}" ${WS}/><path d="M-2 -76 l3 -4" stroke="#fff" stroke-width="2"/>` : `<circle cy="-65" r="7" fill="#7a4a2a" ${WS}/><circle cx="-2" cy="-67" r="1.2" fill="${INK}"/><circle cx="2" cy="-67" r="1.2" fill="${INK}"/>`; return `<rect x="-2.5" y="-60" width="5" height="96" rx="2" fill="${wood}" ${WS}/>${top}`; }   // оставлено из прежнего стиля
      case 'crook': return `<rect x="-2.5" y="-48" width="5" height="84" rx="2" fill="#8fbf4a" ${WS}/><path d="M-2.5 -20 h5 M-2.5 8 h5" stroke="${INK}" stroke-width="1.2"/><path d="M0 -48 C-3 -62 10 -68 13 -58 C15 -50 5 -47 5 -54" fill="none" stroke="${INK}" stroke-width="7.5" stroke-linecap="round"/><path d="M0 -48 C-3 -62 10 -68 13 -58 C15 -50 5 -47 5 -54" fill="none" stroke="#8fbf4a" stroke-width="4" stroke-linecap="round"/><path d="M-3 -40 q-8 -2 -9 -8 q7 0 9 8 z" fill="#5fc25f" stroke="${INK}" stroke-width="1.2"/>`;   // оставлено из прежнего стиля
      case 'censer': {   // кадило из кокоса
        const c = hi ? m : '#7a4a2a';
        return `<path d="M0 0 V22" stroke="${INK}" stroke-width="2" stroke-dasharray="3 2"/><path d="M-10 24 Q0 20 10 24 Q9 38 0 39 Q-9 38 -10 24 Z" fill="${c}" ${WS}/>`
          + line('M-7 30 l2 2 M-2 34 l2 2 M4 30 l2 2', 'rgba(255,255,255,.35)', 1.2) + `<path d="M-10 24 Q0 28 10 24" fill="none" stroke="#f4efe4" stroke-width="2"/>`
          + `<circle cx="-4" cy="14" r="3" fill="rgba(235,235,245,.55)"/><circle cx="2" cy="8" r="4" fill="rgba(235,235,245,.45)"/><circle cx="-1" cy="0" r="3.4" fill="rgba(235,235,245,.35)"/>`;
      }
      default: return '';
    }
  }
  // щиты обезьян: центр в (0,0)
  function shield(kind, rar) {
    const m = METAL[rar] || METAL.common, hi = rar && rar !== 'common';
    switch (kind) {
      case 'scutum':   // огромный банановый лист
        return `<path d="M0 -23 C15 -14 16 12 0 23 C-16 12 -15 -14 0 -23 Z" fill="${hi ? m : '#5aa84a'}" ${WS}/>`
          + `<path d="M0 -20 V21 M0 -12 l-8 -4 M0 -4 l-10 -4 M0 4 l-10 -4 M0 12 l-8 -4 M0 -12 l8 -4 M0 -4 l10 -4 M0 4 l10 -4 M0 12 l8 -4" fill="none" stroke="rgba(20,60,20,.5)" stroke-width="1.4" stroke-linecap="round"/>`;

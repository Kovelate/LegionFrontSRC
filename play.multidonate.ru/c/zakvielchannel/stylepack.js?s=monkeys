    colorNames: { '#9c8a72': 'Бурый', '#8a7a62': 'Тёмно-бурый', '#b09a78': 'Светло-бурый', '#6f6252': 'Коричневый', '#3a3438': 'Чёрный', '#55504f': 'Тёмно-серый', '#8b5a3c': 'Каштановый', '#a0683f': 'Медный', '#c96f3f': 'Рыжий', '#d98a3a': 'Огненно-рыжий', '#b8b2a8': 'Серебристый', '#e8e2d6': 'Снежный', '#e0b060': 'Золотистый', '#7b8a4a': 'Болотный', '#5b8fd6': 'Синий', '#8a6ad6': 'Фиолетовый', '#4fb08a': 'Мятный', '#e06a9a': 'Розовый', '#3fa7b5': 'Бирюзовый', '#c43d3d': 'Малиновый', '#d6c24a': 'Жёлтый', '#6a5acd': 'Индиго' },
    bodies,
    frame(b) {

  }
  // доспехи обезьян: сама вещь без стойки, низ на y = 0. Лорика — жилет из банановой кожуры, мантия — шаманская накидка из листьев
  const ARMOR_RAR = { uncommon: '#4cc95a', rare: '#4aa3ff', epic: '#b06bff', legendary: '#ffb83d' };
  function armor(kind, rar) {
    const tr = rar === 'common' || !ARMOR_RAR[rar] ? null : ARMOR_RAR[rar];
    if (kind === 'robe') {
      let leaves = '';
      const rows = [[-96, 22], [-76, 28], [-56, 33], [-36, 37], [-16, 41]];
      rows.forEach(([y, hw], r) => { for (let x = -hw; x <= hw; x += 11) leaves += `<path d="M${x} ${y} q-6 10 0 22 q6 -12 0 -22 z" fill="${(r + Math.round(x / 11)) % 2 ? '#5aa84a' : '#3f8a3a'}" ${WS}/>`; });
      return `<path d="M-22 -100 Q0 -92 22 -100" fill="none" stroke="${tr || '#8a5a2b'}" stroke-width="6" stroke-linecap="round"/>${leaves}`
        + `<circle cx="0" cy="-96" r="5" fill="${tr || '#ffd84a'}" ${WS}/><path d="M-3 -96 h6" stroke="${INK}" stroke-width="1.2"/>`;
    }
    const peel = tr || BANANA;
    return `<path d="M-30 -96 C-34 -70 -30 -40 -26 -20 H26 C30 -40 34 -70 30 -96 Q0 -86 -30 -96 Z" fill="#8a5a2b" ${WS}/>`
      + [-20, -7, 6, 19].map((x, i) => `<path d="M${x - 6} -92 C${x - 8} -60 ${x - 6} -30 ${x} 0 C${x + 6} -30 ${x + 8} -60 ${x + 6} -92 Z" fill="${peel}" ${WS}/><circle cx="${x - 2}" cy="${-60 + i * 6}" r="1.5" fill="#6b4a2a" opacity=".55"/><circle cx="${x + 2}" cy="${-36 - i * 4}" r="1.2" fill="#6b4a2a" opacity=".55"/>`).join('')
      + `<path d="M-44 -98 Q-34 -112 -14 -102 L-16 -84 Q-34 -86 -44 -78 Z M44 -98 Q34 -112 14 -102 L16 -84 Q34 -86 44 -78 Z" fill="${peel}" ${WS}/>`
      + `<path d="M-12 -100 Q0 -92 12 -100" fill="none" stroke="#6b4a2a" stroke-width="4"/>`;
  }

  /* ── ауры: свечение за телом, поднимающиеся бананчики, звёзды, огоньки, снежинки ── */
  const AURA = { gold: ['#ffd76a', '#ffb83d'], sparks: ['#fff6c8', '#ffd76a'], halo: ['#ffe27a', '#ffe27a'], shadow: ['#a24bff', '#3a0f66'], frost: ['#bfe8ff', '#6fb8ff'] };
  function aura(kind, k) {
    const b = k.b, seed = k.seed >>> 0;
    const c = AURA[kind]; if (!c) return { back: '', front: '' };
    const id = k.uid('jlA'), d0 = (seed % 997) / 997 * 2;
    const cx = 60, cy = (b.top + 170) / 2 + 2, rx = (b.R - b.L) / 2 + 46, ry = (170 - b.top) / 2 + 42;
    let back = '', front = '';
    const glow = (op1, op2, dur) => `<defs><radialGradient id="${id}"><stop offset=".3" stop-color="${c[0]}"/><stop offset=".62" stop-color="${c[1]}" stop-opacity=".7"/><stop offset="1" stop-color="${c[1]}" stop-opacity="0"/></radialGradient></defs>`
      + `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="url(#${id})"><animate attributeName="opacity" values="${op1};${op2};${op1}" dur="${dur}s" begin="-${d0.toFixed(2)}s" repeatCount="indefinite"/></ellipse>`;
    const motes = (n, col, shape, size) => Array.from({ length: n }, (_, i) => {
      const x = b.L - 8 + ((i * 37 + (seed >>> (i % 8))) % (b.R - b.L + 16)), y0 = 168 - (i * 23) % 40, dur = 1.8 + (i % 4) * 0.45, beg = ((i * 0.53 + d0) % dur).toFixed(2);
      const sh = shape === 'banana' ? banana(0, 0, size, col) : shape === 'star' ? `<path d="${starP(0, 0, size)}" fill="${col}"/>` : shape === 'flake' ? `<path d="M0 ${-size} V${size} M${-size} 0 H${size} M${f1(-size * 0.7)} ${f1(-size * 0.7)} L${f1(size * 0.7)} ${f1(size * 0.7)} M${f1(size * 0.7)} ${f1(-size * 0.7)} L${f1(-size * 0.7)} ${f1(size * 0.7)}" stroke="${col}" stroke-width="1.6" stroke-linecap="round"/>` : `<circle r="${size}" fill="${col}"/>`;
      return `<g opacity="0"><animateTransform attributeName="transform" type="translate" values="${x} ${y0};${x + (i % 2 ? 6 : -6)} ${y0 - 70}" dur="${dur}s" begin="-${beg}s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;1;0" keyTimes="0;.2;.7;1" dur="${dur}s" begin="-${beg}s" repeatCount="indefinite"/>${sh}</g>`;
    }).join('');
    if (kind === 'gold') { back = glow(0.7, 1, 2.4); front = motes(8, '#ffe27a', 'banana', 5.5); }
    else if (kind === 'sparks') { back = glow(0.25, 0.45, 2); front = motes(12, '#fff6c8', 'star', 4.5); }
    else if (kind === 'shadow') { back = glow(0.75, 1, 1.6); front = motes(11, '#c48bff', 'dot', 3.2); }
    else if (kind === 'frost') { back = glow(0.6, 0.95, 2.8); front = motes(10, '#e6f7ff', 'flake', 4.4); }
    else if (kind === 'halo') {
      const t = (b.square ? b.top - 6 : b.top) - 30;
      front = `<g><animateTransform attributeName="transform" type="translate" values="0 0;0 -3;0 0" dur="2.2s" begin="-${d0.toFixed(2)}s" repeatCount="indefinite"/>`
        + `<ellipse cx="60" cy="${t}" rx="19" ry="5.5" fill="none" stroke="#fff3b0" stroke-width="9" opacity=".35"/><ellipse cx="60" cy="${t}" rx="19" ry="5.5" fill="none" stroke="#ffe27a" stroke-width="4"><animate attributeName="stroke-opacity" values=".75;1;.75" dur="1.6s" repeatCount="indefinite"/></ellipse></g>`;
    }
    return { back, front };
  }

  // длинная рука: обводка + мех; ладошка светлая, с пальчиками
  const limb = (d, col) => `<path d="${d}" fill="none" stroke="${INK}" stroke-width="8.5" stroke-linecap="round"/><path d="${d}" fill="none" stroke="${col}" stroke-width="4.5" stroke-linecap="round"/>`;
  const palm = (x, y, dir, col = FACE) => `<circle cx="${x}" cy="${y}" r="5.4" fill="${col}" stroke="${INK}" stroke-width="2.2"/><path d="M${x - 2.4} ${f1(y + dir * 4.2)} v${-dir * 2.6} M${x} ${f1(y + dir * 4.6)} v${-dir * 2.8} M${x + 2.4} ${f1(y + dir * 4.2)} v${-dir * 2.6}" stroke="${INK}" stroke-width="1.1" stroke-linecap="round"/>`;
  const fist = (x, y, col = FACE) => `<circle cx="${x}" cy="${y}" r="6" fill="${col}" stroke="${INK}" stroke-width="2.2"/><path d="M${x - 4} ${y - 1} q2 -2.4 4 0 q2 -2.4 4 0" fill="none" stroke="${INK}" stroke-width="1.2" stroke-linecap="round"/>`;   // сжатый кулак

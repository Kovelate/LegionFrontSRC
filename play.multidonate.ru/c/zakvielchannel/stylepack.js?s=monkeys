    // 19.10: «Плащ первопроходца» у обезьянки — плащ исследователя джунглей: край листьями, застёжки-листки
    pioneer: { cloak: '#3d5a3a', lining: '#d8f0b0', line: INK, ink: INK, w: 3, flare: 24, hem: 'leaf', clasp: 'leaf', clasp2: '#ffd36b' },
